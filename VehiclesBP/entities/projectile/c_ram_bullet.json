{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:c_ram_bullet",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"runtime_identifier": "minecraft:small_fireball"
		},
		"components": {
			"minecraft:collision_box": {
				"width": 0.2,
				"height": 0.2
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": true
			},
			"minecraft:conditional_bandwidth_optimization": {
				"default_values": {
					"max_optimized_distance": 80,
					"max_dropped_ticks": 10,
					"use_motion_prediction_hints": true
				}
			},
			"minecraft:tick_world": {
				"never_despawn": true
			},
			"minecraft:timer": {
				"looping": true,
				"time": 5,
				"time_down_event": {
					"event": "af:despawn",
					"target": "self"
				}
			},
			"minecraft:projectile": {
				"power": 10,
				"gravity": 0.01,
				"uncertainty_base": 0,
				"uncertainty_multiplier": 0,
				"anchor": 1,
				"reflect_on_hurt": false,
				"offset": [
					0,
					-0.7,
					-1
				],
				"shoot_sound": "shoot",
				"angle_offset": 0,
				"on_hit": {
					"impact_damage": {
						"destroy_on_hit": false,
						"damage": 20,
						"knockback": true
					},
					"particle_on_hit": {
						"particle_type": "lava",
						"num_particles": 5,
						"on_entity_hit": true,
						"on_other_hit": true
					},
					"remove_on_hit": {}
				},
				"destroy_on_hurt": false,
				"stop_on_hurt": false,
				"multiple_targets": true,
				"inertia": 1
			},
			"minecraft:type_family": {
				"family": [
					"bullet",
					"c_ram"
				]
			}
		},
		"events": {
			"af:despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			},
			"af:roar": {
				"queue_command": {
					"command": [
						"event entity @e[type=af:c_ram,c=1] af:start_roar"
					]
				}
			}
		},
		"component_groups": {
			"despawn": {
				"minecraft:instant_despawn": {}
			}
		}
	}
}