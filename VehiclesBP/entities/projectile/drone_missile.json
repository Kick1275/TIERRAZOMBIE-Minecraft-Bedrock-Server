{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:drone_missile",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"components": {
			"minecraft:collision_box": {
				"width": 2,
				"height": 2
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": true
			},
			"minecraft:conditional_bandwidth_optimization": {
				"default_values": {
					"max_optimized_distance": 80,
					"max_dropped_ticks": 10,
					"use_motion_prediction_hints": true
				}
			},
			"minecraft:timer": {
				"looping": false,
				"time": 2,
				"time_down_event": {
					"event": "af:explodable",
					"target": "self"
				}
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "entity_explosion",
						"on_damage": {
							"event": "minecraft:explode",
							"target": "self"
						}
					},
					{
						"cause": "suffocation",
						"on_damage": {
							"event": "minecraft:explode",
							"target": "self"
						}
					},
					{
						"cause": "projectile",
						"on_damage": {
							"event": "minecraft:explode",
							"target": "self"
						}
					},
					{
						"cause": "drowning",
						"on_damage": {
							"event": "minecraft:explode",
							"target": "self"
						}
					}
				]
			},
			"minecraft:fire_immune": {},
			"minecraft:breathable": {
				"breathes_air": true,
				"total_supply": 0,
				"suffocateTime": 0
			}
		},
		"events": {
			"minecraft:explode": {
				"add": {
					"component_groups": [
						"explode"
					]
				},
				"queue_command": {
					"command": [
						"particle af:explosion_dust ~ ~1 ~"
					]
				}
			},
			"af:join_libernia": {
				"add": {
					"component_groups": [
						"libernia"
					]
				},
				"remove": {
					"component_groups": [
						"telslakia"
					]
				},
				"queue_command": {
					"command": [
						"playsound missile.fire @a ~ ~ ~ 100 1"
					]
				}
			},
			"af:join_telslakia": {
				"add": {
					"component_groups": [
						"telslakia"
					]
				},
				"remove": {
					"component_groups": [
						"libernia"
					]
				},
				"queue_command": {
					"command": [
						"playsound missile.fire @a ~ ~ ~ 100 1"
					]
				}
			},
			"minecraft:entity_spawned": {
				"queue_command": {
					"command": [
						"playsound missile.fire @a ~ ~ ~ 100 1"
					]
				}
			},
			"af:despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			},
			"af:explodable": {
				"add": {
					"component_groups": [
						"explosion_sensor"
					]
				}
			}
		},
		"component_groups": {
			"explode": {
				"minecraft:explode": {
					"fuse_length": 0,
					"fuse_lit": true,
					"power": 3,
					"causes_fire": true,
					"breaks_blocks": true,
					"destroy_affected_by_griefing": true
				}
			},
			"libernia": {
				"minecraft:type_family": {
					"family": [
						"libernia_missile",
						"libernia",
						"inanimate"
					]
				}
			},
			"telslakia": {
				"minecraft:type_family": {
					"family": [
						"telslakia_missile",
						"telslakia",
						"inanimate"
					]
				}
			},
			"despawn": {
				"minecraft:instant_despawn": {}
			},
			"explosion_sensor": {
				"minecraft:target_nearby_sensor": {
					"inside_range": 1,
					"on_inside_range": {
						"event": "minecraft:explode",
						"target": "self"
					},
					"outside_range": 2
				},
				"minecraft:timer": {
					"looping": false,
					"time": 5,
					"time_down_event": {
						"event": "minecraft:explode",
						"target": "self"
					}
				}
			}
		}
	}
}