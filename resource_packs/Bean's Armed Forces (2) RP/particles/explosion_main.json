{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "af:explosion_main",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/explosion_rise_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 0
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 5
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [
					0,
					-2,
					0
				],
				"radius": 3,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2,4)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-10,10)",
				"rotation_rate": "math.random(v.particle_lifetime*-1,v.particle_lifetime)"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					"5+(2*(5*v.particle_age*(1.5-v.particle_age)))",
					0
				],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"2+(v.particle_age/2)",
					"5+(v.particle_age*3)"
				],
				"facing_camera_mode": "rotate_y",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#5E363636",
						"0.36": "#853E3B3A",
						"1.0": "#00504D4B"
					}
				}
			}
		}
	}
}