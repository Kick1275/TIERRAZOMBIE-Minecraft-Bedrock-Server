{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "af:spas12",
			"item": {
				"af:spas12": "query.owner_identifier=='minecraft:player'"
			},
			"materials": {
				"default": "entity_emissive_alpha",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/armor/spas12",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.spas12"
			},
			"animations": {
				"tp_wield": "animation.af_gun.tp_wield",
				"fp_wield": "animation.af_gun.fp_wield",
				"fp_reload": "animation.af_gun.fp_reload",
				"fp_run": "animation.af_gun.fp_run",
				"fp_sneak": "animation.af_gun.fp_sneak",
				"fp_nosneak": "animation.af_gun.fp_nosneak",
				"general": "controller.animation.af_gun.general"
			},
			"scripts": {
				"pre_animation": [
					"variable.charge_amount=math.clamp((query.main_hand_item_max_duration-(query.main_hand_item_use_duration-query.frame_alpha+1.0))/10.0,0.0,1.0f);"
				],
				"animate": [
					{
						"tp_wield": "!c.is_first_person"
					},
					{
						"general": "c.is_first_person"
					},
					{
						"fp_reload": "c.is_first_person"
					}
				]
			},
			"sound_effects": {
				"reload": "item.shotgun.rack",
				"trigger": "af.attachables.gun.trigger",
				"firing": "item.shotgun.shoot"
			},
			"render_controllers": [
				"controller.render.af_items.enchanted"
			]
		}
	}
}