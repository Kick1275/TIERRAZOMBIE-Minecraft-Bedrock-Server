{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.helicopter.flying": {
			"states": {
				"default": {
					"transitions": [
						{
							"active": "q.has_rider||!q.is_on_ground"
						}
					],
					"blend_transition": 1
				},
				"active": {
					"animations": [
						"rotor",
						"fly",
						"rotations"
					],
					"transitions": [
						{
							"default": "!q.has_rider&&q.is_on_ground"
						}
					],
					"blend_transition": 1
				}
			}
		}
	}
}