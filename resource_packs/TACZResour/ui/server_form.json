  "long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [
            "100% - 14px",
            10
          ],
          "size": [
            225,
            200
          ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - 'Custom dial') and (#title_text - 'Custom triple') and (#title_text - 'grip13') and (#title_text - 'Main') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "custom_dial": {
          "size": [
            600,
            350
          ],
