{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.dacia.terrain": {
			"states": {
				"default": {
					"animations": [
						{
							"down": "[(query.ground_speed >= 4.75)]"
						},
						{
							"up": "[(query.ground_speed < 4.75)]"
						}
					]
				}
			}
		},
		"controller.animation.dacia.driving": {
			"states": {
				"default": {
					"transitions": [
						{
							"smoke": "query.is_moving"
						}
					]
				},
				"smoke": {
					"transitions": [
						{
							"default": "!query.is_moving"
						}
					],
					"particle_effects": [
						{
							"effect": "smoke",
							"locator": "exhaust"
						}
					]
				}
			}
		},
		"controller.animation.dacia.fatal": {
			"states": {
				"default": {
					"transitions": [
						{
							"fatal": "query.health <= 25"
						}
					]
				},
				"fatal": {
					"transitions": [
						{
							"default": "query.health > 25"
						}
					],
					"particle_effects": [
						{
							"effect": "engine",
							"locator": "engine"
						},
						{
							"effect": "flame",
							"locator": "engine"
						}
					]
				}
			}
		}
	}
}