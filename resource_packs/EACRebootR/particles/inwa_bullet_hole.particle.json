{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "deltan:inwa_bullet_hole",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/inwa_bullethole"
			}
		},
		"events": {
			"smoke": {
				"particle_effect": {
					"effect": "deltan:inwa_bullet_smoke",
					"type": "emitter"
				}
			},
			"spark": {
				"particle_effect": {
					"effect": "deltan:inwa_bullet_spark",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 100
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": ["smoke", "spark"]
			},
			"minecraft:emitter_shape_point": {
				"offset": [0.025, 0.025, 0.025]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 5
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [0, 0.01, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.1, 0.1],
				"facing_camera_mode": "direction_z",
				"direction": {
					"mode": "custom",
					"custom_direction": ["v.direction.x", "v.direction.y", "v.direction.z"]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.96": "#FFFFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}