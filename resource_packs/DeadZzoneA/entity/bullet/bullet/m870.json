{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "bullet:m870",
      "materials": {
        "default": "entity_alphablend"
      },
      "textures": {
        "default": "textures/bullet"
      },
      "geometry": {
        "default": "geometry.bullet"
      },
      "animations": {
        "move": "animation.bullet.move",
        "bullet": "animation.bullet"
      },
      "scripts": {
        "pre_animation": [
          "variable.shake = query.shake_time - query.frame_alpha;",
          "variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;"
        ],
        "animate": [
          "move",
          "bullet"
        ]
      },
      "render_controllers": [ "controller.render.bullet" ]
    }
  }
}