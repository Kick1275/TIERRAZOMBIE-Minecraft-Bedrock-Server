      "scripts": {
        "scale": "0.9375",
        "initialize": [
          "v.is_holding_right = 0.0;",
          "v.is_blinking = 0.0;",
          "v.last_blink_time = 0.0;",
          "v.hand_bob = 0.0;"
        ],
        "pre_animation": [
          "v.reload = q.property('mcpe:reload');",
          "v.crosshair_color = q.property('mcpe:crosshair_color');",
          "v.helmet_layer_visible = 1.0;",
          "v.leg_layer_visible = 1.0;",
          "v.boot_layer_visible = 1.0;",
          "v.chest_layer_visible = 1.0;",
          "v.attack_body_rot_y = Math.sin(360*Math.sqrt(v.attack_time)) * 5.0;",
          "v.tcos0 = (math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed / v.gliding_speed_value) * 57.3;",
          "v.first_person_rotation_factor = math.sin((1 - v.attack_time) * 180.0);",
          "v.hand_bob = q.life_time < 0.01 ? 0.0 : v.hand_bob + ((q.is_on_ground && q.is_alive ? math.clamp(math.sqrt(math.pow(q.position_delta(0), 2.0) + math.pow(q.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - v.hand_bob) * 0.02;",
          "v.map_angle = math.clamp(1 - v.player_x_rotation / 45.1, 0.0, 1.0);",
          "v.item_use_normalized = q.main_hand_item_use_duration / q.main_hand_item_max_duration;",
          "v.guns = q.equipped_item_any_tag('slot.weapon.mainhand', 'guns');",
          "v.empty_guns = q.equipped_item_any_tag('slot.weapon.mainhand', 'empty_guns');",
          "v.all_ss1 =  q.get_equipped_item_name('main_hand') == 'ss1' || q.get_equipped_item_name('main_hand') == 'ss1_emp';",
          "v.ss1 = q.get_equipped_item_name('main_hand') == 'ss1';",
          "v.ss1_emp = q.get_equipped_item_name('main_hand') == 'ss1_emp';",
          "v.all_ak47 = q.get_equipped_item_name('main_hand') == 'ak47' || q.get_equipped_item_name('main_hand') == 'ak47_emp';",
          "v.ak47 = q.get_equipped_item_name('main_hand') == 'ak47';",
          "v.ak47_emp = q.get_equipped_item_name('main_hand') == 'ak47_emp';",
          "v.all_python = q.get_equipped_item_name('main_hand') == 'python' || q.get_equipped_item_name('main_hand') == 'python_emp';",
          "v.python = q.get_equipped_item_name('main_hand') == 'python';",
          "v.python_emp = q.get_equipped_item_name('main_hand') == 'python_emp';",
