{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.svd.person": {
      "initial_state": "draw",
      "states": {
        "draw": {
          "animations": [
           {
            "guns.draw": "variable.all_svd"
            }
          ],
          "transitions": [
            {
              "holding": "variable.all_svd && query.any_animation_finished"
            },
            {
              "draw": "!variable.all_svd"
            }
          ]
        },
        "holding": {
          "blend_transition": 0.1,
          "blend_via_shortest_path": true,
          "animations": [
           {
            "guns.hold": "variable.all_svd"
            }
          ],
          "transitions": [
            {
              "sprint": "variable.all_svd && query.is_sprinting && !q.is_in_water"
            },
            {
              "aim": "variable.all_svd && query.is_sneaking"
            },
            {
              "back": "variable.all_svd && query.is_swimming && query.is_in_water"
            },
            {
              "reload": "variable.svd_emp && query.mark_variant == 1"
            },
            {
              "draw": "!variable.all_svd"
            }
          ]
        },
        "sprint": {
          "blend_transition": 0.1,
          "blend_via_shortest_path": true,
          "animations": [
           {
            "guns.sprint": "variable.all_svd"
            }
          ],
          "transitions": [
            {
             "holding": "variable.all_svd && !query.is_sprinting"
            },
            {
              "back": "variable.all_svd && query.is_swimming && query.is_in_water"
            },
            {
              "reload": "variable.svd_emp && query.mark_variant == 1"
            },
            {
              "draw": "!variable.all_svd"
            }
          ]
        },
        "back": {
          "blend_transition": 0.1,
          "blend_via_shortest_path": true,
          "animations": [
           {
            "guns.back": "variable.all_svd"
            }
          ],
          "transitions": [
            {
             "holding": "variable.all_svd && !query.is_swimming"
            },
            {
             "sprint": "variable.all_svd && query.is_sprinting && !query.is_in_water"
            },
            {
              "reload": "variable.svd_emp && query.mark_variant == 1"
            },
            {
              "draw": "!variable.all_svd"
            }
          ]
        },
        "aim": {
          "blend_transition": 0.1,
          "blend_via_shortest_path": true,
          "animations": [
           {
            "guns.aim": "variable.all_svd"
            }
          ],
          "transitions": [
            {
             "holding": "variable.all_svd && !query.is_sneaking"
            },
            {
              "reload": "variable.svd_emp && query.mark_variant == 1"
            },
            {
              "draw": "!variable.all_svd"
            }
          ]
        },
        "reload": {
          "blend_transition": 0.1,
          "blend_via_shortest_path": true,
          "animations": [
           {
            "ak2.reload_full": "variable.all_svd"
            }
          ],
          "transitions": [
            {
              "holding": "variable.all_svd && query.all_animations_finished"
            },
            {
              "draw": "!variable.all_svd"
            }
          ]
        }
      }
    }
  }
}