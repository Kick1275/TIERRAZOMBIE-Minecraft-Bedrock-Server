					"alpha": "@hud.anim_actionbar_text_alpha_out"
				}
			}
		]
	},
	
	"deadzonewatermark": {
		"type": "label",
		"text": "V1.6.6-1",
		"font_type": "normal",
		"shadow": true,
		"localize": true,
		"alpha": 0.43,
		"layer": 31
	},
	
	"crosshair": {
		"type": "panel",
		"size": [
			34,
			34
		],
		"controls": [
			{
				"hud_player": {
					"type": "custom",
					"renderer": "live_player_renderer",
