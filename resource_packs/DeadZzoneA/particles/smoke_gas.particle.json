{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "nz:smoke_gas",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 500
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 2
			},
			"minecraft:emitter_shape_sphere": {
				"offset": ["math.random(1, -1)", 0.1, "math.random(-1, 1)"],
				"radius": 1,
				"surface_only": true,
				"direction": ["math.random(10, -5)", 0, "math.random(-5, 10)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 4.5
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": 1
			},
			"minecraft:particle_initial_speed": 5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_1 -0.5)", 2, "(variable.particle_random_1 -0.5)"],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.08 + variable.particle_age) - (0.05 * variable.particle_age)", "(0.08 + variable.particle_age) - (0.05 * variable.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 3,
						"max_frame": 8
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00CCCCCC",
						"0.11": "#82CCCCCC",
						"0.51": "#33878787",
						"1.0": "#00565656"
					}
				}
			}
		}
	}
}