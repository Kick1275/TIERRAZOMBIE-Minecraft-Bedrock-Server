{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "minecraft:critical_hit_emitter",
			"basic_render_parameters": {
				"material": "particles_opaque",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 15
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.3
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 10
			},
			"minecraft:particle_initial_speed": 3,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -19, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.06 + variable.particle_random_1*0.06) - (0.01 * variable.particle_age)", "(0.06 + variable.particle_random_1*0.06) - (0.01 * variable.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [3, 56],
					"uv_size": [2, 2]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 10,
				"collision_radius": 0.03
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFBF2323",
						"1.0": "#FF293607"
					}
				}
			}
		}
	}
}