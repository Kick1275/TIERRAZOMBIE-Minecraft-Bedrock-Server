{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "minecraft:block_destruct",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "atlas.terrain"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "variable.emitter_particles_count / 3"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": ["Math.random(-variable.emitter_radius, variable.emitter_radius)", 0, "Math.random(-variable.emitter_radius, variable.emitter_radius)"],
				"half_dimensions": [0.0, 0.5, 0.0],
				"direction": ["Math.random(-1,1)", "Math.random(-1, 1)", "Math.random(-1, 1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.2f / (Math.random(0.0, 0.001) * 0.9f + 0.1f)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,90)"
			},
			"minecraft:particle_initial_speed": "Math.random(0, 4)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -9.8, 0],
				"linear_drag_coefficient": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.particle_random_1 * 0.075 + 0.08 - v.particle_age / 13", "variable.particle_random_1 * 0.075 + 0.08 - v.particle_age / 13"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 1,
					"uv": ["variable.emitter_texture_coordinate.u + (variable.emitter_texture_size.u/4) * (variable.particle_random_1*3)", "variable.emitter_texture_coordinate.v + (variable.emitter_texture_size.v/4) * (variable.particle_random_2*3)"],
					"uv_size": ["variable.emitter_texture_size.u/4", "variable.emitter_texture_size.v/4"]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 5,
				"coefficient_of_restitution": 0.6,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.color.r", "variable.color.g", "variable.color.b", "variable.color.a"]
			}
		}
	}
}