{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "af:a10",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/a10/a10",
				"libernia": "textures/entity/a10/a10_libernia",
				"telslakia": "textures/entity/a10/a10_telslakia"
			},
			"geometry": {
				"default": "geometry.a10"
			},
			"render_controllers": [
				"controller.render.a10",
				"controller.render.faction_emblems"
			],
			"spawn_egg": {
				"texture": "af_a10_egg",
				"texture_index": 0
			},
			"animations": {
				"fly": "animation.a10.fly",
				"landed": "controller.animation.aircraft.landed",
				"pitch": "animation.aircraft.pitch",
				"yaw": "animation.aircraft.yaw",
				"rotations": "animation.aircraft.rotations",
				"scale": "animation.a10.scale",
				"particles": "animation.aircraft.particles",
				"smooth_land": "controller.animation.aircraft.smooth_land"
			},
			"scripts": {
				"animate": [
					"landed",
					"scale",
					"pitch",
					"yaw",
					"smooth_land",
					{
						"particles": "query.modified_move_speed>=0.5&&!query.is_on_ground"
					}
				],
				"should_update_bones_and_effects_offscreen": true,
				"should_update_effects_offscreen": true
			},
			"particle_effects": {
				"contrail": "af:contrail"
			}
		}
	}
}