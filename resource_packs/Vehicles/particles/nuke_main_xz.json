{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "af:nuke_main_xz",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/nuke_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 50
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 20
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					0,
					1,
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2,10)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180,180)",
				"rotation_rate": "math.random(-180,180)"
			},
			"minecraft:particle_initial_speed": "math.random(1,5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"(variable.particle_random_1*5-2.5)",
					50,
					"(variable.particle_random_2*5-2.5)"
				],
				"linear_drag_coefficient": 15
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"32*v.particle_age",
					"32*v.particle_age"
				],
				"facing_camera_mode": "emitter_transform_xz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.5": "#FFFFFFFF",
						"0.72": "#FFFFA900",
						"0.96": "#03940000",
						"1.0": "#00FF0000"
					}
				}
			}
