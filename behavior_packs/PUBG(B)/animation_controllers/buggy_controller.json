{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.buggy_startup": {
      "states": {
        "default": {
          "transitions": [
            {
              "start_up": "query.has_rider"
            }
          ]
        },
        "start_up": {
          "transitions": [
            {
              "default": "!query.has_rider"
            }
          ],
          "on_entry": [
            "/playsound vehicle.buggy.startup @a[r=50] ~~~"
          ]
        }
      }
    },
    "controller.animation.buggy_sound_stop": {
      "states": {
        "default": {
          "transitions": [
            {
              "sound_stop": "!query.has_rider"
            }
          ]
        },
        "sound_stop": {
          "transitions": [
            {
              "default": "query.has_rider"
            }
          ],
          "on_entry": [
            "/stopsound @a[r=5] vehicle.buggy.drive",
            "/playsound vehicle.buggy.startup @a[r=50] ~~~"
          ]
        }
      }
    },
    "controller.animation.buggy_damage_slow": {
      "states": {
        "default": {
          "transitions": [
            {
              "damage_slow": "query.ground_speed > 11.8"
            }
          ]
        },
        "damage_slow": {
          "transitions": [
            {
              "default": "query.ground_speed < 11.8"
            }
          ],
          "on_entry": [
            "@s buggy:damage_slow"
          ]
        }
      }
    },
    "controller.animation.buggy_damage_fast": {
      "states": {
        "default": {
          "transitions": [
            {
              "damage_fast": "query.ground_speed > 17.6"
            }
          ]
        },
        "damage_fast": {
          "transitions": [
            {
              "default": "query.ground_speed < 17.6"
            }
          ],
          "on_entry": [
            "@s buggy:damage_fast",
            "@s buggy:break_block"
          ]
        }
      }
    },
    "controller.animation.buggy_drive": {
      "states": {
        "default": {
          "transitions": [
            {
              "drive": "query.ground_speed > 4.4"
            }
          ]
        },
        "drive": {
          "transitions": [
            {
              "default": "query.ground_speed < 4.4"
            }
          ],
          "on_entry": [
            "@s buggy_speed_1"
          ]
        }
      }
    },
    "controller.animation.buggy_idle": {
      "states": {
        "default": {
          "transitions": [
            {
              "idle": "query.ground_speed < 1"
            }
          ]
        },
        "idle": {
          "transitions": [
            {
              "default": "query.ground_speed > 1"
            }
          ],
          "on_entry": [
            "@s buggy:idle",
            "/stopsound @a[r=5] vehicle.buggy.drive",
            "/playsound vehicle.buggy.startup @a[r=50] ~~~",
            "@s buggy:movement_basic"
          ]
        }
      }
    },
    "controller.animation.buggy_seat": {
      "states": {
        "default": {
          "transitions": [
            {
              "riding": "(1.0)"
            }
          ],
          "on_entry": [
            "/function buggy_seat"
          ]
        },
        "riding": {
          "transitions": [
            {
              "default": "query.has_rider"
            }
          ],
          "on_entry": [
            "/function buggy_seat"
          ]
        }
      }
    },
    "controller.animation.buggy_destroyed": {
      "states": {
        "default": {
          "transitions": [
            {
              "destroyed": "query.is_alive"
            }
          ]
        },
        "destroyed": {
          "transitions": [
            {
              "default": "!query.is_alive"
            }
          ],
          "on_entry": [
            "/summon pubg:explosion"
          ]
        }
      }
    }
  }
}