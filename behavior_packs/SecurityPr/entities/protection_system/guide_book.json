{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "rt:spb_guide_book",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "spb_guide_book_controller": "controller.animation.spb_guide_book",
        "change_page_animation": "animation.change_page"
      },
      "scripts": {
        "animate": [
          "spb_guide_book_controller"
        ]
      }
    },
    "component_groups": {
      "instant_despawn_group": {
        "minecraft:instant_despawn": {}
      },
      "player_sensor_open_group": {
        "minecraft:entity_sensor": {
          "sensor_range": 6,
          "relative_range": false,
          "event_filters": {
            "test": "is_family",
            "subject": "other",
            "value": "player"
          },
          "event": "player_open_event"
        }
      },
      "player_sensor_test_group": {
        "minecraft:entity_sensor": {
          "sensor_range": 6,
          "relative_range": false,
          "event_filters": {
            "test": "is_family",
            "subject": "other",
            "value": "player"
          },
          "event": "player_open_event"
        },
        "minecraft:timer": {
          "looping": false,
          "time": 1,
          "time_down_event": {
            "event": "close_event"
          }
        }
      },
      "timer_remove_group": {
        "minecraft:timer": {
          "looping": false,
          "time": 2,
          "time_down_event": {
            "event": "despawn_book_event"
          }
        }
      },
      "timer_sensor_group": {
        "minecraft:timer": {
          "looping": false,
          "time": 10,
          "time_down_event": {
            "event": "player_test_event"
          }
        }
      },
      "interact_group": {
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    }
                  ]
                },
                "event": "add_angry_event"
              },
              "swing": true,
              "interact_text": "action.interact.use.button.book"
            }
          ]
        }
      },
      "open_group": {
        "minecraft:is_baby": {}
      },
      "change_page_group": {
        "minecraft:angry": {
          "duration": 1,
          "calm_event": {
            "event": "remove_angry_event",
            "target": "self"
          }
        }
      },
      "variant_0_group": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "variant_1_group": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "variant_2_group": {
        "minecraft:variant": {
          "value": 2
        }
      },
      "variant_3_group": {
        "minecraft:variant": {
          "value": 3
        }
      },
      "variant_4_group": {
        "minecraft:variant": {
          "value": 4
        }
      },
      "damage_sensor_remove_group": {
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "event": "remove_book_event",
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    }
                  ]
                }
              },
              "deals_damage": false
            },
            {
              "deals_damage": false
            }
          ]
        }
      },
      "damage_sensor_inmmune_group": {
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "deals_damage": false
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 2,
        "height": 4
      },
      "minecraft:physics": {
        "has_collision": true,
        "has_gravity": true
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:fire_immune": true
    },
    "events": {
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "scoreboard objectives add pagessk dummy"
          ]
        },
        "add": {
          "component_groups": [
            "player_sensor_open_group",
            "damage_sensor_remove_group"
          ]
        }
      },
      "player_open_event": {
        "add": {
          "component_groups": [
            "interact_group",
            "open_group",
            "timer_sensor_group"
          ]
        },
        "remove": {
          "component_groups": [
            "player_sensor_open_group",
            "player_sensor_test_group"
          ]
        }
      },
      "player_test_event": {
        "add": {
          "component_groups": [
            "player_sensor_test_group"
          ]
        },
        "remove": {
          "component_groups": [
            "timer_sensor_group"
          ]
        }
      },
      "page_1_event": {
        "add": {
          "component_groups": [
            "variant_0_group"
          ]
        }
      },
      "page_2_event": {
        "add": {
          "component_groups": [
            "variant_1_group"
          ]
        }
      },
      "page_3_event": {
        "add": {
          "component_groups": [
            "variant_2_group"
          ]
        }
      },
      "page_4_event": {
        "add": {
          "component_groups": [
            "variant_3_group"
          ]
        }
      },
      "remove_angry_event": {
        "remove": {
          "component_groups": [
            "change_page_group"
          ]
        },
        "add": {
          "component_groups": [
            "interact_group"
          ]
        }
      },
      "add_angry_event": {
        "add": {
          "component_groups": [
            "change_page_group"
          ]
        },
        "remove": {
          "component_groups": [
            "interact_group"
          ]
        }
      },
      "change_page_event": {
        "queue_command": {
          "command": [
            "scoreboard players add @s pagessk 1",
            "execute if score @s pagessk matches 1 run event entity @s page_2_event",
            "execute if score @s pagessk matches 2 run event entity @s page_3_event",
            "execute if score @s pagessk matches 3 run event entity @s page_4_event",
            "execute if score @s pagessk matches 4 run event entity @s page_1_event",
            "execute if score @s pagessk matches 4 run scoreboard players set @s pagessk 0"
          ]
        }
      },
      "close_event": {
        "add": {
          "component_groups": [
            "player_sensor_open_group"
          ]
        },
        "remove": {
          "component_groups": [
            "change_page_group",
            "player_sensor_open_group",
            "player_sensor_test_group",
            "interact_group",
            "timer_sensor_group",
            "open_group"
          ]
        }
      },
      "despawn_book_event": {
        "add": {
          "component_groups": [
            "instant_despawn_group"
          ]
        }
      },
      "remove_book_event": {
        "queue_command": {
          "command": [
            "structure load spb_guide_book ~~~"
          ]
        },
        "add": {
          "component_groups": [
            "timer_remove_group",
            "damage_sensor_inmmune_group"
          ]
        },
        "remove": {
          "component_groups": [
            "open_group",
            "interact_group",
            "player_sensor_open_group",
            "damage_sensor_remove_group"
          ]
        }
      }
    }
  }
}