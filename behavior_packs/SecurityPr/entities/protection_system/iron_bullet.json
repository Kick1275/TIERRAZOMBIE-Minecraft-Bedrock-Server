{
  "format_version": "1.20.60",
  "minecraft:entity": {
    "description": {
      "identifier": "rt:iron_bullet",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:snowball"
    },
    "component_groups": {
      "instant_despawn_group": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 0.45,
        "height": 0.45
      },
      "minecraft:timer": {
        "looping": false,
        "time": 0.5,
        "time_down_event": {
          "event": "instant_despawn_event"
        }
      },
      "minecraft:projectile": {
        "on_hit": {
          "impact_damage": {
            "knockback": true,
            "damage": 4
          },
          "stick_in_ground": {
            "shake_time": 0
          },
          "arrow_effect": {},
          "definition_event": {
            "event_trigger": {
              "event": "projectile_event",
              "target": "self"
            }
          }
        },
        "anchor": 1,
        "power": 2,
        "inertia": 1,
        "gravity": 0.001,
        "offset": [0,-0.2,0]
      },
      "minecraft:physics": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "particle minecraft:basic_smoke_particle ~~~",
            "particle minecraft:llama_spit_smoke ~~~"
          ]
        }
      },
      "projectile_event": {
        "queue_command": {
          "command": [
            "particle rt:hit_iron_bullet ~~~",
            "event entity @s instant_despawn_event"
          ]
        }
      },
      "instant_despawn_event": {
        "add": {
          "component_groups": [
            "instant_despawn_group"
          ]
        }
      }
    }
  }
}