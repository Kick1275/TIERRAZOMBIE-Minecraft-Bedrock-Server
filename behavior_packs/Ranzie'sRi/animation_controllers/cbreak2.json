{
"format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.holding_iron_pickaxe2": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "holding": "query.has_target"
            }
          ]
        },
        "holding": {
          "animations": [ "break2","sound" ],
          "transitions": [
            {
              "default": "!query.has_target"
            }
          ]
        }
      }
    }
  }
}
