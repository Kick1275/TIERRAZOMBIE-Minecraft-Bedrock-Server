{
	"format_version": "1.21.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:centrifuge_results",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"result": {
				"minecraft:loot": {
					"table": "loot_tables/uranium_refinement_chance.json"
				}
			},
			"interupt": {
				"minecraft:loot": {
					"table": "loot_tables/raw_uranium.json"
				}
			}
		},
		"components": {
			"minecraft:timer": {
				"looping": true,
				"time": 0.1,
				"time_down_event": {
					"event": "af:death",
					"target": "self"
				}
			}
		},
		"events": {
			"af:result": {
				"add": {
					"component_groups": [
						"result"
					]
				}
			},
			"af:interupt": {
				"add": {
					"component_groups": [
						"interupt"
					]
				}
			},
			"af:death": {
				"queue_command": {
					"command": [
						"kill @s"
					]
				}
			}
		}
	}
}