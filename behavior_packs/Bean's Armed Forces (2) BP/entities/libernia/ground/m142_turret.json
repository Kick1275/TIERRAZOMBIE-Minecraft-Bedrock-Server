		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"libernia"
					]
				},
				"queue_command": {
					"command": [
						"scoreboard objectives add RocketAmmo dummy",
						"scoreboard objectives add RocketLoaded dummy",
						"scoreboard objectives add RocketRemaining dummy",
						"scoreboard players set @s RocketAmmo 0",
						"scoreboard players set @s RocketLoaded 0",
						"scoreboard players set @s RocketRemaining 0"
					]
				}
			},
			"af:join_telslakia": {
				"add": {
					"component_groups": [
						"telslakia"
					]
				},
				"remove": {
					"component_groups": [
						"libernia"
					]
				}
			},
			"af:join_libernia": {
				"add": {
					"component_groups": [
						"libernia"
					]
				},
				"remove": {
					"component_groups": [
						"telslakia"
					]
				}
			},
			"af:shot_fired": {
				"queue_command": {
					"command": [
						"tag @s remove loading",
						"playsound tank.fire_inside @p[r=2]",
						"playsound missile.fire @a ~ ~ ~ 100 1",
						"particle af:launch_smoke ~ ~ ~",
						"scoreboard players add @s RocketAmmo 1",
						"scoreboard players operation @s RocketRemaining = @s RocketLoaded",
						"scoreboard players operation @s RocketRemaining -= @s RocketAmmo",
						"title @p[r=5] actionbar {\"rawtext\":[{\"text\":\"(\"},{\"score\":{\"name\":\"@s\",\"objective\":\"RocketRemaining\"}},{\"text\":\"/\"},{\"score\":{\"name\":\"@s\",\"objective\":\"RocketLoaded\"}},{\"text\":\") Rockets\"}]}",
						"tag @s remove magazine_empty",
						"execute as @s if score @s RocketAmmo = @s RocketLoaded run tag @s add magazine_empty",
						"execute as @s[tag=magazine_empty] run tag @s remove R_loaded",
						"execute as @s[tag=magazine_empty] run tag @s remove full",
						"execute as @s[tag=magazine_empty] at @s run tag @e[type=af:m142,r=3,c=1] remove full",
						"execute as @s[tag=magazine_empty] run scoreboard players set @s RocketAmmo 0",
						"execute as @s[tag=magazine_empty] run scoreboard players set @s RocketLoaded 0",
						"tag @s remove magazine_empty"
					]
				},
				"add": {
					"component_groups": [
						"af:fired"
					]
				}
			},
			"af:stop_fired": {
				"remove": {
					"component_groups": [
						"af:fired"
					]
				}
			},
			"af:R_loaded": {
				"queue_command": {
					"command": [
						"execute as @s unless score @s RocketLoaded matches 6.. run scoreboard players add @s RocketLoaded 1",
						"tag @s add R_loaded",
						"scoreboard players operation @s RocketRemaining = @s RocketLoaded",
						"scoreboard players operation @s RocketRemaining -= @s RocketAmmo",
						"title @a[r=8] actionbar {\"rawtext\":[{\"text\":\"§aRocket loaded (\"},{\"score\":{\"name\":\"@s\",\"objective\":\"RocketLoaded\"}},{\"text\":\"/6)\"}]}",
						"execute as @s if score @s RocketLoaded matches 6 run tag @s add full",
						"execute as @s if score @s RocketLoaded matches 6 at @s run tag @e[type=af:m142,r=3,c=1] add full"
					]
				}
			},
			"af:death": {
				"queue_command": {
					"command": [
						"particle af:explosionball_main",
						"camera @a[r=5] clear"
					]
				}
			},
			"af:inform": {
				"queue_command": {
					"command": [
						"title @p actionbar exit the Vehicle to load this item."
					]
				}
			},
			"af:inform_speed": {
				"queue_command": {
					"command": [
						"title @p actionbar you can not fire whilst moving."
					]
				}
			},
			"af:empty": {
				"queue_command": {
					"command": [
						"playanimation @s animation.m142.empty"
					]
				}
			},
			"af:camo_baf": {
