				"is_pushable": true,
				"is_pushable_by_piston": true
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"on_damage": {
							"filters": [
								{
									"test": "is_family",
									"value": "libernian_soldier",
									"subject": "other"
								}
							]
						},
						"deals_damage": false
					},
					{
						"on_damage": {
							"filters": [
								{
									"test": "is_family",
									"value": "vehicle",
									"subject": "other"
								}
							]
						},
						"damage_multiplier": 10,
						"deals_damage": true
					},
					{
						"on_damage": {
							"filters": [
								{
									"test": "is_family",
									"value": "sentry",
									"subject": "other"
								}
							]
						},
						"damage_multiplier": 10,
						"deals_damage": true
					}
				]
			},
			"minecraft:on_target_escape": {
