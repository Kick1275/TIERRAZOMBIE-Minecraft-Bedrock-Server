				"target": "self"
			},
			"minecraft:leashable": {
				"soft_distance": 5,
				"hard_distance": 10,
				"max_distance": 16
			},
			"minecraft:equipment": {
				"table": "loot_tables/libernian_soldier.json"
			},
			"minecraft:interact": {
				"interactions": [
					{
						"on_interact": {
							"filters": {
								"all_of": [
									{
										"test": "has_equipment",
										"domain": "hand",
										"subject": "other",
										"value": "af:manual"
									}
								]
							},
							"event": "af:manual",
							"target": "self"
						},
						"play_sounds": "purr",
						"interact_text": "action.interact.use"
					},
					{
						"on_interact": {
							"filters": {
								"all_of": [
									{
										"test": "is_family",
										"subject": "other",
										"value": "player"
									},
									{
										"test": "has_equipment",
										"domain": "hand",
										"subject": "other",
										"value": "af:manual",
										"operator": "!="
									},
									{
										"test": "has_component",
										"subject": "self",
										"value": "minecraft:is_ignited",
										"operator": "=="
									},
									{
										"test": "is_sneaking",
										"subject": "other",
										"operator": "!="
									}
								]
							},
							"event": "af:can_move",
							"target": "self"
						},
						"play_sounds": "flap",
						"interact_text": "action.interact.edit"
					},
					{
						"on_interact": {
							"filters": {
								"all_of": [
									{
										"test": "is_family",
										"subject": "other",
										"value": "player"
									},
									{
										"test": "has_equipment",
										"domain": "hand",
										"subject": "other",
										"value": "af:manual",
										"operator": "!="
									},
									{
										"test": "has_component",
										"subject": "self",
										"value": "minecraft:is_ignited",
										"operator": "!="
									},
									{
										"test": "is_sneaking",
										"subject": "other",
										"operator": "!="
									}
								]
							},
							"event": "af:cant_move",
							"target": "self"
						},
						"play_sounds": "flap",
						"interact_text": "action.interact.edit"
					}
				]
			},
			"minecraft:knockback_resistance": {
				"value": 0.5,
				"max": 1
			},
			"minecraft:behavior.float": {
				"priority": 0
			},
			"minecraft:healable": {
				"items": [
					{
						"item": "af:rations",
						"heal_amount": 5
					}
				]
			},
			"minecraft:behavior.avoid_block": {
				"priority": 9,
				"tick_interval": 5,
				"search_range": 4,
				"search_height": 4,
				"sprint_speed_modifier": 1.1,
				"target_selection_method": "nearest",
				"target_blocks": [
					"af:barbed_wire"
				]
			}
		},
		"component_groups": {
			"angry": {
				"minecraft:angry": {
					"duration": 25,
					"broadcast_anger": true,
					"broadcast_range": 32,
					"calm_event": {
						"event": "minecraft:on_calm",
						"target": "self"
					},
					"broadcast_targets": [
						"libernian_soldier"
					],
					"sound_interval": {
						"range_min": 3,
						"range_max": 5
					}
				}
			},
			"calm": {
				"minecraft:on_target_acquired": {
					"event": "minecraft:become_angry",
					"target": "self"
				}
			},
			"can_move": {
				"minecraft:home": {
					"restriction_radius": 32
				},
				"minecraft:behavior.move_towards_home_restriction": {
					"priority": 6,
					"speed_multiplier": 1.5
				},
				"minecraft:behavior.tempt": {
					"priority": 5,
					"items": [
						"af:rations"
					],
					"can_tempt_vertically": true,
					"speed_multiplier": 1.5,
					"within_radius": 16
				},
				"minecraft:behavior.move_to_random_block": {
					"priority": 14,
					"speed_multiplier": 0.8,
					"within_radius": 8,
					"block_distance": 16
				}
			},
			"cant_move": {
				"minecraft:home": {
					"restriction_radius": 8
				},
				"minecraft:behavior.go_home": {
					"priority": 3,
					"goal_radius": 0.5
				},
				"minecraft:behavior.move_towards_home_restriction": {
					"priority": 5,
					"speed_multiplier": 1.5
				},
				"minecraft:is_ignited": {}
			},
			"throw_smoke": {
				"minecraft:behavior.ranged_attack": {
					"priority": 4,
					"attack_interval_min": 4,
					"attack_interval_max": 8,
					"attack_radius": 16,
					"speed_multiplier": 1.5,
					"attack_radius_min": 8
				},
				"minecraft:shooter": {
					"def": "af:thrown_grenade_smoke"
				},
				"minecraft:timer": {
					"looping": true,
					"time": [
						10,
						16
					],
					"time_down_event": {
						"event": "af:stop_throw_smoke",
						"target": "self"
					}
				}
			},
			"shoot_default": {
				"minecraft:behavior.ranged_attack": {
					"priority": 4,
					"attack_interval_min": 2,
					"attack_interval_max": 5,
					"attack_radius": 32,
					"burst_shots": 16,
					"burst_interval": 0.25,
					"speed_multiplier": 1.5,
					"attack_radius_min": 3
				},
				"minecraft:shooter": {
					"def": "af:m4carbine_bullet<af:soldier>"
				}
			}
		},
		"events": {
			"minecraft:on_calm": {
				"add": {
					"component_groups": [
						"calm"
					]
				},
				"remove": {
					"component_groups": [
						"angry"
					]
				}
			},
			"minecraft:become_angry": {
				"sequence": [
					{
						"randomize": [
							{
								"weight": 95,
								"add": {
									"component_groups": [
										"angry",
										"shoot_default"
									]
								},
								"remove": {
									"component_groups": [
										"calm",
										"throw_smoke"
									]
								}
							},
							{
								"weight": 5,
								"add": {
									"component_groups": [
										"angry",
										"throw_smoke"
									]
								},
								"remove": {
									"component_groups": [
										"calm",
										"shoot_default"
									]
								}
							}
						]
					}
				]
			},
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"calm",
						"can_move",
						"shoot_default"
					]
				},
				"queue_command": {
					"command": [
						"title @p actionbar interact to change behavior."
					]
				}
			},
			"af:manual": {
				"queue_command": {
					"command": [
						"title @p actionbar interact to change behavior, can be healed with rations."
					]
				}
			},
			"af:can_move": {
				"add": {
					"component_groups": [
						"can_move"
					]
				},
				"remove": {
					"component_groups": [
						"cant_move"
					]
				},
				"queue_command": {
					"command": [
						"title @p actionbar order: can move",
						"effect @s slowness 0 0 true"
					]
				}
			},
			"af:cant_move": {
				"add": {
					"component_groups": [
						"cant_move"
					]
				},
				"remove": {
					"component_groups": [
						"can_move"
					]
				},
				"queue_command": {
					"command": [
						"title @p actionbar order: cant move",
						"effect @s slowness infinite 255 true"
					]
				}
			},
			"af:stop_throw_smoke": {
				"remove": {
					"component_groups": [
						"throw_smoke"
					]
				},
				"add": {
					"component_groups": [
						"shoot_default"
					]
				}
			}
		}
	}
}