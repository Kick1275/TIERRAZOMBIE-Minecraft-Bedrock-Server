					},
					{
						"on_interact": {
							"event": "af:faction_join",
							"filters": {
								"all_of": [
									{
										"test": "has_tag",
										"subject": "self",
										"value": "libernia",
										"operator": "!="
									},
									{
										"test": "has_tag",
										"subject": "self",
										"value": "telslakia",
										"operator": "!="
									}
								]
							},
							"target": "self"
						},
						"play_sounds": "milk",
						"interact_text": "action.interact.use"
					},
					{
						"on_interact": {
							"event": "af:branch_join",
							"filters": {
								"all_of": [
									{
										"any_of": [
											{
												"test": "has_tag",
												"subject": "self",
												"value": "libernia",
												"operator": "=="
											},
											{
												"test": "has_tag",
												"subject": "self",
												"value": "telslakia",
