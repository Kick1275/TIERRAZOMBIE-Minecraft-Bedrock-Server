												"value": "air",
												"operator": "!="
											},
											{
												"test": "has_tag",
												"subject": "self",
												"value": "navy",
												"operator": "!="
											}
										]
									}
								]
							},
							"target": "self"
						},
						"play_sounds": "milk",
						"interact_text": "action.interact.use"
					}
				]
			}
