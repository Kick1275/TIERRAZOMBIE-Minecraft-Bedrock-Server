			"minecraft:can_climb": {},
			"minecraft:interact": {
				"interactions": [
					{
						"on_interact": {
							"filters": {
								"all_of": [
									{
										"test": "has_equipment",
										"domain": "hand",
										"subject": "other",
										"value": "af:manual"
									}
								]
							},
							"event": "af:manual",
							"target": "self"
						},
						"play_sounds": "purr",
