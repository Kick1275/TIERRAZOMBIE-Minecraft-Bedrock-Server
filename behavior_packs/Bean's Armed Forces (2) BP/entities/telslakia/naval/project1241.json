						"execute as @s if score @s CannonAmmo matches 10 run title @p[r=5] actionbar (6/16) Shells",
						"execute as @s if score @s CannonAmmo matches 11 run title @p[r=5] actionbar (5/16) Shells",
						"execute as @s if score @s CannonAmmo matches 12 run title @p[r=5] actionbar (4/16) Shells",
						"execute as @s if score @s CannonAmmo matches 13 run title @p[r=5] actionbar (3/16) Shells",
						"execute as @s if score @s CannonAmmo matches 14 run title @p[r=5] actionbar (2/16) Shells",
						"execute as @s if score @s CannonAmmo matches 15 run title @p[r=5] actionbar (1/16) Shells",
						"execute as @s if score @s CannonAmmo matches 16.. run title @p[r=5] actionbar (0/16) Shells",
						"execute as @s if score @s CannonAmmo matches 16.. run tag @s remove AC_loaded",
						"execute as @s if score @s CannonAmmo matches 16.. run tag @s remove AP_loaded",
						"execute as @s if score @s CannonAmmo matches 16.. run tag @s remove HE_loaded",
						"execute as @s[tag=AP_loaded] at @s run event entity @n[type=af:project1241_turret] af:AP_fired",
						"execute as @s[tag=HE_loaded] at @s run event entity @n[type=af:project1241_turret] af:HE_fired"
					]
				}
			},
			"af:load_HE": {
				"queue_command": {
					"command": [
						"playsound tank.autoload @p",
						"title @p actionbar HE Belt loading",
						"tag @s add loading"
					]
				},
				"add": {
					"component_groups": [
						"af:cooldown_HE"
					]
				}
			},
			"af:HE_loaded": {
				"queue_command": {
					"command": [
						"playsound tank.beep @p",
						"tag @s add HE_loaded",
						"tag @s add AC_loaded",
						"tag @s remove loading",
						"scoreboard players set @s CannonAmmo 0",
						"title @p[r=5] actionbar (16/16) HE Shells"
					]
				},
				"remove": {
					"component_groups": [
						"af:cooldown_AP"
					]
				}
			},
			"af:scope": {
				"queue_command": {
					"command": [
						"execute as @p at @s run tag @s[tag=scopeview] add scope_toggle",
						"execute as @p at @s run tag @s[tag=scope_toggle] remove scopeview",
						"execute as @p at @s run tag @s[tag=!scope_toggle] add scopeview",
						"execute as @p at @s run tag @s remove scope_toggle"
					]
				}
			},
			"af:GM_detonated": {
				"queue_command": {
					"command": [
						"tag @s remove GM_fired"
					]
				}
			},
			"af:GM_fired": {
				"queue_command": {
					"command": [
						"tag @s remove loading",
						"playsound tank.fire_inside @p[r=2]",
						"playsound missile.fire @a ~ ~ ~ 100 1",
						"tag @s remove GM_loaded",
						"tag @s add GM_fired"
					]
				}
			},
			"af:load_GM": {
				"add": {
					"component_groups": [
						"af:cooldown_GM"
					]
				},
				"queue_command": {
					"command": [
						"title @p actionbar Missile System loading",
						"tag @s add loading",
						"playsound vehicle.system_load @p[r=2]"
					]
				}
			},
			"af:GM_loaded": {
				"queue_command": {
					"command": [
						"tag @s add GM_loaded",
						"playsound tank.beep @p[r=2]",
						"title @p[r=1] actionbar Missile ready",
						"tag @s remove loading"
					]
				},
				"remove": {
					"component_groups": [
						"af:cooldown_GM"
					]
				}
			},
			"af:AA_fired": {
				"queue_command": {
					"command": [
						"summon af:missile_air ^-3 ^7 ^8 ~ -45",
						"title @p actionbar 3s cooldown..."
					]
				}
			},
			"af:AG_fired": {
				"queue_command": {
					"command": [
						"summon af:missile_ground ^3 ^7 ^8 ~ -45",
						"title @p actionbar 3s cooldown..."
					]
				}
			}
		}
	}
}