						"execute as @e[r=64,family=collider,family=type075] at @s run execute as @n[r=4,tag=carrier_capable] as @s if score @s PayloadAmmo matches 1.. run tag @s remove no_payload",
						"execute as @e[r=64,family=collider,family=type075] at @s run execute as @n[r=4,tag=carrier_capable] as @s if score @s PayloadAmmo matches 1.. run title @p actionbar aircraft restocked",
						"execute as @e[r=64,family=collider,family=type075] at @s run execute as @n[r=4,tag=carrier_capable] as @s if score @s PayloadAmmo matches 1.. run scoreboard players set @s PayloadAmmo 0",
						"execute as @e[r=64,family=collider,family=type075] at @s run tp @n[r=16,tag=carrier_capable,tag=!has_rider] ^5 ^0.1 ^ ~ ~"
