				"queue_command": {
					"command": [
						"camerashake add @a[r=32] 0.01 0.1 positional",
						"playsound electric.drive @a ~ ~ ~ 5 0.8",
						"execute as @s at @s if block ~ ~ ~ water run particle af:wake_once ^ ^ ^16"
					]
				}
			},
