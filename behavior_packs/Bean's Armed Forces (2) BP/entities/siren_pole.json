{
	"format_version": "1.21.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:siren_pole",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},
		"components": {
			"minecraft:knockback_resistance": {
				"value": 1,
				"max": 1
			},
			"minecraft:health": {
				"value": 5
			},
			"minecraft:collision_box": {
				"width": 0.5,
				"height": 8
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:movement": {
				"value": 0,
				"max": 0
			},
			"minecraft:physics": {
				"has_gravity": false,
				"has_collision": false
			},
			"minecraft:fire_immune": true,
			"minecraft:loot": {
				"table": "loot_tables/siren_pole.json"
			},
			"minecraft:reflect_projectiles": {
				"reflected_projectiles": [
					"minecraft:arrow",
					"minecraft:wind_charge_projectile"
				],
				"reflection_scale": 0.25,
				"azimuth_angle": "180.0 + Math.random(-20.0, 20.0)"
			},
			"minecraft:renders_when_invisible": {},
			"minecraft:body_rotation_axis_aligned": {},
			"minecraft:is_collidable": {},
			"minecraft:on_death": {
				"event": "af:death",
				"target": "self"
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"queue_command": {
					"command": [
						"title @p actionbar drops on death, use passports to play anthem.",
						"effect @s invisibility infinite 1 true",
						"playsound place.iron @a ~ ~ ~"
					]
				},
				"add": {
					"component_groups": [
						"idle"
					]
				}
			},
			"af:despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				},
				"queue_command": {
					"command": [
						"stopsound @a libernia.speaker",
						"stopsound @a telslakia.speaker"
					]
				}
			},
			"af:stop": {
				"remove": {
					"component_groups": [
						"audio"
					]
				},
				"queue_command": {
					"command": [
						"stopsound @a libernia.speaker",
						"stopsound @a telslakia.speaker"
					]
				},
				"add": {
					"component_groups": [
						"idle"
					]
				}
			},
			"af:play_telslakia": {
				"queue_command": {
					"command": [
						"playsound telslakia.speaker @a[r=16] ~ ~ ~ 100 1"
					]
				},
				"add": {
					"component_groups": [
						"audio"
					]
				},
				"remove": {
					"component_groups": [
						"idle"
					]
				}
			},
			"af:play_libernia": {
				"queue_command": {
					"command": [
						"playsound libernia.speaker @a[r=16] ~ ~ ~ 100 1"
					]
				},
				"add": {
					"component_groups": [
						"audio"
					]
				},
				"remove": {
					"component_groups": [
						"idle"
					]
				}
			},
			"af:manual": {
				"queue_command": {
					"command": [
						"title @p actionbar Will play National Themes of the respective ID card you use on it."
					]
				}
			},
			"af:death": {
				"queue_command": {
					"command": [
						"function block_break"
					]
				}
			}
		},
		"component_groups": {
			"despawn": {
				"minecraft:instant_despawn": {}
			},
			"audio": {
				"minecraft:timer": {
					"time": 80,
					"time_down_event": {
						"event": "af:stop"
					}
				},
				"minecraft:is_ignited": {},
				"minecraft:interact": {
					"interactions": [
						{
							"on_interact": {
								"event": "af:stop",
								"target": "self"
							}
						}
					]
				}
			},
			"idle": {
				"minecraft:interact": {
					"interactions": [
						{
							"add_items": {
								"table": "loot_tables/siren_pole.json"
							},
							"interact_text": "action.interact.war_table",
							"on_interact": {
								"event": "af:despawn",
								"target": "self",
								"filters": {
									"test": "is_sneaking",
									"subject": "other",
									"value": true
								}
							},
							"play_sounds": "death"
						},
						{
							"interact_text": "action.interact.use",
							"on_interact": {
								"event": "af:play_telslakia",
								"target": "self",
								"filters": [
									{
										"all_of": [
											{
												"test": "has_equipment",
												"subject": "other",
												"domain": "hand",
												"value": "af:telslakia_id"
											}
										]
									}
								]
							}
						},
						{
							"interact_text": "action.interact.use",
							"on_interact": {
								"event": "af:play_libernia",
								"target": "self",
								"filters": [
									{
										"all_of": [
											{
												"test": "has_equipment",
												"subject": "other",
												"domain": "hand",
												"value": "af:libernia_id"
											}
										]
									}
								]
							}
						},
						{
							"interact_text": "action.interact.use",
							"on_interact": {
								"event": "af:manual",
								"target": "self",
								"filters": [
									{
										"all_of": [
											{
												"test": "has_equipment",
												"subject": "other",
												"domain": "hand",
												"value": "af:manual"
											}
										]
									}
								]
							},
							"play_sounds": "purr"
						}
					]
				}
			}
		}
	}
}