{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:c_ram_bullet",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"runtime_identifier": "minecraft:small_fireball"
		},
		"components": {
			"minecraft:collision_box": {
				"width": 0.2,
				"height": 0.2
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": true
			},
			"minecraft:conditional_bandwidth_optimization": {
				"default_values": {
					"max_optimized_distance": 80,
					"max_dropped_ticks": 10,
					"use_motion_prediction_hints": true
				}
			},
			"minecraft:tick_world": {
				"never_despawn": true
			},
			"minecraft:timer": {
				"looping": true,
				"time": 0.1,
				"time_down_event": {
					"event": "af:update",
					"target": "self"
				}
			},
			"minecraft:projectile": {
				"power": 10,
				"gravity": 0.01,
				"uncertainty_base": 0,
				"uncertainty_multiplier": 0,
				"anchor": 0,
				"reflect_on_hurt": false,
				"offset": [
					0,
					2.5,
					0
				],
				"shoot_sound": "shoot",
				"angle_offset": 0,
				"on_hit": {
					"impact_damage": {
						"destroy_on_hit": false,
						"damage": 20,
						"knockback": true
					},
					"particle_on_hit": {
						"particle_type": "lava",
						"num_particles": 0,
						"on_entity_hit": true,
						"on_other_hit": true
					},
					"remove_on_hit": {}
				},
				"destroy_on_hurt": false,
				"stop_on_hurt": false,
				"multiple_targets": true,
				"inertia": 1
			},
			"minecraft:type_family": {
				"family": [
					"bullet",
					"c_ram"
				]
			},
			"minecraft:explode": {
				"power": 3,
				"causes_fire": false,
				"breaks_blocks": false,
				"fuse_length": 1
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"queue_command": {
					"command": [
						"camerashake add @a[r=16] 0.1 0.1 positional",
						"execute as @n[family=inanimate,r=8] at @s run particle af:tank_flash ^^2.5^5"
					]
				}
			},
			"af:explode": {
				"add": {
					"component_groups": [
						"explode"
					]
				}
			},
			"af:update": {
				"queue_command": {
					"command": [
						"execute as @s at @s if entity @e[family=aerial,r=8] run event entity @s af:explode"
					]
				}
			}
		},
		"component_groups": {
			"explode": {
				"minecraft:explode": {
					"power": 3,
					"causes_fire": false,
					"breaks_blocks": false,
					"fuse_length": 0
				}
			}
		}
	}
}