{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:guided_missile",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
				"af:missile.speed": {
					"type": "int",
					"default": 7,
					"range": [
						1,
						50
					]
				}
			}
		},
		"components": {
			"minecraft:collision_box": {
				"width": 2,
				"height": 2
			},
			"minecraft:conditional_bandwidth_optimization": {
				"default_values": {
					"max_optimized_distance": 80,
					"max_dropped_ticks": 10,
					"use_motion_prediction_hints": true
				}
			},
			"minecraft:tick_world": {
				"never_despawn": true
			},
			"minecraft:type_family": {
				"family": [
					"inanimate",
					"missile"
				]
			}
		},
		"events": {
			"minecraft:explode": {
				"add": {
					"component_groups": [
						"explode"
					]
				},
				"queue_command": {
					"command": [
						"execute as @s[tag=!exploded] at @s run damage @e[r=5,family=!inanimate] 250 entity_explosion entity @s",
						"execute as @s[tag=!exploded] at @s run function explosion_effects",
						"tag @s add exploded",
						"kill @e[family=missile,r=4]"
					]
				}
			},
			"minecraft:entity_spawned": {
				"queue_command": {
					"command": [
						"playsound missile.fire @a ~ ~ ~ 10 1"
					]
				}
			}
		},
		"component_groups": {
			"explode": {
				"minecraft:explode": {
					"fuse_length": 0.1,
					"fuse_lit": true,
					"power": 3,
					"causes_fire": true,
					"breaks_blocks": true,
					"destroy_affected_by_griefing": true
				}
			}
		}
	}
}