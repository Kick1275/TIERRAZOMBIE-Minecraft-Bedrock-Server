{
	"format_version": "1.16.0",
	"minecraft:entity": {
		"description": {
			"identifier": "af:flare_entity",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"runtime_identifier": "minecraft:snowball"
		},
		"components": {
			"minecraft:collision_box": {
				"width": 3,
				"height": 3
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": true
			},
			"minecraft:conditional_bandwidth_optimization": {
				"default_values": {
					"max_optimized_distance": 80,
					"max_dropped_ticks": 10,
					"use_motion_prediction_hints": true
				}
			},
			"minecraft:tick_world": {
				"never_despawn": true
			},
			"minecraft:projectile": {
				"power": 1,
				"gravity": 0.02,
				"uncertainty_base": 8,
				"uncertainty_multiplier": 0,
				"anchor": 1,
				"reflect_on_hurt": true,
				"offset": [
					0,
					1,
					0
				],
				"shoot_sound": "shoot",
				"angle_offset": -135,
				"on_hit": {
					"impact_damage": {
						"destroy_on_hit": false
					},
					"stick_in_ground": {
						"shake_time": 0
					}
				},
				"destroy_on_hurt": false
			},
			"minecraft:type_family": {
				"family": [
					"flare",
					"aerial",
					"vehicle"
				]
			},
			"minecraft:explode": {
				"fuse_length": 10,
				"fuse_lit": true,
				"power": 0,
				"causes_fire": false,
				"breaks_blocks": false,
				"destroy_affected_by_griefing": true
			}
		},
		"events": {
			"af:thrown": {
				"add": {
					"component_groups": [
						"thrown"
					]
				}
			}
		},
		"component_groups": {
			"thrown": {
				"minecraft:projectile": {
					"power": 1,
					"gravity": 0.02,
					"uncertainty_base": 0,
					"uncertainty_multiplier": 0,
					"anchor": 1,
					"reflect_on_hurt": true,
					"offset": [
						0,
						1,
						0
					],
					"shoot_sound": "shoot",
					"angle_offset": 0,
					"on_hit": {
						"impact_damage": {
							"destroy_on_hit": false
						},
						"stick_in_ground": {
							"shake_time": 0
						}
					},
					"destroy_on_hurt": false
				},
				"minecraft:explode": {
					"fuse_length": 60,
					"fuse_lit": true,
					"power": 0,
					"causes_fire": false,
					"breaks_blocks": false,
					"destroy_affected_by_griefing": true
				}
			}
		}
	}
}