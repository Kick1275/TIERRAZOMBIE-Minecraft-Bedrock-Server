{
	"format_version": "1.21.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:radar_receiver",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"active": {
				"minecraft:is_charged": {}
			},
			"inactive": {},
			"despawn": {
				"minecraft:instant_despawn": {}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": [
					"inanimate"
				]
			},
			"minecraft:body_rotation_axis_aligned": {},
			"minecraft:loot": {
				"table": "loot_tables/radar_receiver.json"
			},
			"minecraft:health": {
				"value": 5
			},
			"minecraft:knockback_resistance": {
				"value": 1,
				"max": 1
			},
			"minecraft:collision_box": {
				"width": 0.9,
				"height": 1
			},
			"minecraft:is_collidable": {},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": false
			},
			"minecraft:timer": {
				"looping": true,
				"time": 0.5,
				"time_down_event": {
					"event": "af:update",
					"target": "self"
				}
			},
			"minecraft:reflect_projectiles": {
				"reflected_projectiles": [
					"minecraft:arrow",
					"minecraft:wind_charge_projectile"
				],
				"reflection_scale": 0.25,
				"azimuth_angle": "180.0 + Math.random(-20.0, 20.0)"
			},
			"minecraft:interact": {
				"interactions": [
					{
						"on_interact": {
							"filters": [
								{
									"test": "has_equipment",
									"subject": "other",
									"value": "af:manual",
									"domain": "hand"
								}
							],
							"event": "af:manual",
							"target": "self"
						}
					}
				]
			},
			"minecraft:on_death": {
				"event": "af:death",
				"target": "self"
			},
			"minecraft:renders_when_invisible": {}
		},
		"events": {
			"minecraft:entity_spawned": {
				"queue_command": {
					"command": [
						"title @p actionbar needs active RADAR within 16 blocks.",
						"playsound place.iron @a ~ ~ ~",
						"effect @s invisibility infinite 1 true"
					]
				}
			},
			"af:has_signal": {
				"add": {
					"component_groups": [
						"active"
					]
				},
				"remove": {
					"component_groups": [
						"inactive"
					]
				},
				"queue_command": {
					"command": [
						"tag @s add has_signal"
					]
				}
			},
			"af:no_signal": {
				"add": {
					"component_groups": [
						"inactive"
					]
				},
				"remove": {
					"component_groups": [
						"active"
					]
				},
				"queue_command": {
					"command": [
						"tag @s remove has_signal"
					]
				}
			},
			"af:update": {
				"queue_command": {
					"command": [
						"execute as @s[tag=!has_signal] at @s if entity @e[type=af:radar,tag=radar_on,r=16] run event entity @s af:has_signal",
						"execute as @s[tag=has_signal] at @s unless entity @e[type=af:radar,tag=radar_on,r=16] run event entity @s af:no_signal",
						"execute as @s[tag=has_signal] at @s run title @a[r=3] actionbar §a@e[family=!turret,tag=on_radar,r=256]"
					]
				}
			},
			"af:manual": {
				"queue_command": {
					"command": [
						"title @p actionbar needs active RADAR within 16 blocks, reads out detected aircraft."
					]
				}
			},
			"af:death": {
				"queue_command": {
					"command": [
						"function block_break"
					]
				}
			},
			"af:despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			}
		}
	}
}