{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:mounted_gun",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"despawn": {
				"minecraft:instant_despawn": {}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": [
					"inanimate",
					"mounted_gun"
				]
			},
			"minecraft:health": {
				"value": 1005
			},
			"minecraft:collision_box": {
				"width": 0.9,
				"height": 0.9
			},
			"minecraft:physics": {
				"has_collision": false,
				"has_gravity": false
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": true
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "fall",
						"deals_damage": false
					},
					{
						"deals_damage": false,
						"cause": "projectile"
					},
					{
						"deals_damage": false,
						"cause": "suffocation"
					}
				]
			},
			"minecraft:knockback_resistance": {
				"value": 1,
				"max": 1
			},
			"minecraft:fire_immune": true,
			"minecraft:environment_sensor": {
				"triggers": []
			},
			"minecraft:interact": {
				"interactions": [
					{
						"on_interact": {
							"target": "self",
							"event": "af:fire_bullet_mounted_gun"
						},
						"play_sounds": "shoot",
						"cooldown": 0.1,
						"interact_text": "action.interact.shoot_mg"
					}
				]
			},
			"minecraft:loot": {
				"table": "loot_tables/mounted_gun.json"
			},
			"minecraft:on_death": {
				"event": "af:death",
				"target": "self"
			},
			"minecraft:renders_when_invisible": {}
		},
		"events": {
			"minecraft:entity_spawned": {
				"queue_command": {
					"command": [
						"summon af:mounted_gun_stand ~~~ ~~",
						"effect @s invisibility infinite 1 true"
					]
				}
			},
			"af:MG_fired": {
				"queue_command": {
					"command": [
						"camerashake add @a[r=16] 0.1 0.1 positional",
						"particle af:gun_firing_particle ^ ^0.5 ^1.8"
					]
				}
			},
			"af:death": {
				"queue_command": {
					"command": [
						"function block_break"
					]
				}
			},
			"af:despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			},
			"af:fire_bullet_mounted_gun": {
				"queue_command": {
					"command": [
						"tag @s add af_fire_script",
						"tag @s remove af_fire_script"
					]
				}
			}
		}
	}
}