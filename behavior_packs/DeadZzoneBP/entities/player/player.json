                "tag @s remove blood_type_b",
                "tag @s remove blood_type_o",
                "playsound player.death @s",
                "camera @s set minecraft:free ease 3 in_out_sine pos ~0 ~5 ~0 rot ~90 ~",
                "execute at @s[tag=!infect] run summon mcpe:player_corpse Corpse",
                "execute at @s[tag=infect] run summon mcpe:player_infect_corpse Corpse",
                "tp @e[type=item, r=8] @e[type=mcpe:player_corpse, r=8, c=1]",
                "tp @e[type=item, r=8] @e[type=mcpe:player_infect_corpse, r=8, c=1]",
                "scoreboard players set @s thirst 20",
                "scoreboard players set @s blood 3500",
                "scoreboard players set @s overdose 0",
                "scoreboard players set @s infection 0",
                "scoreboard players set @s bleedingTimer 0",
                "scoreboard players set @s stamina 20",
                "function thirst",
