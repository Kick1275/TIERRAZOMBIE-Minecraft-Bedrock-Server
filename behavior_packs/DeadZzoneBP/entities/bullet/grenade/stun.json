{
	"format_version": "1.20.60",
	"minecraft:entity": {
		"description": {
			"identifier": "grenade:flash",
			"runtime_identifier": "minecraft:snowball",
			"is_spawnable": false,
			"is_summonable": false
		},
		"components": {
			"minecraft:type_family": {
				"family": ["grenade"]
			},
			"minecraft:collision_box": {
				"width": 0.25,
				"height": 0.25
			},
			"minecraft:projectile": {
				"on_hit": {
					"definition_event": {
						"event_trigger": {
							"event": "minecraft:exploding"
						}
					},
					"stick_in_ground": {
						"shake_time": 0
					}
				},
				"power": 1.2,
				"gravity": 0.03,
				"angleoffset": 0.5,
				"inertia": 1,
				"liquid_inertia": 2,
				"uncertaintyBase": 0.7,
				"anchor": 1,
				"offset": [0,0,0],
				"reflectOnHurt": false,
				"catch_fire": false
			},
			"minecraft:break_blocks": {
				"breakable_blocks": ["glass", "glass_pane", "stained_glass", "tinted_glass", "stained_glass_pane" ]
			},
			"minecraft:physics": {}
		},
		"component_groups": {
			"despawn": {
				"minecraft:instant_despawn": {}
			},
			"minecraft:exploding": {
				"minecraft:timer": {
					"looping": true,
					"time": 3,
					"time_down_event": {
						"event": "flash"
					}
				}
			}
		},
		"events": {
			"minecraft:exploding": {
				"add": {
					"component_groups": [
						"minecraft:exploding"
					]
				}
			},
			"flash": {
				"queue_command": {
					"command": [
						"playsound grenade.flashed @a[r=7] ~~~",
						"playsound grenade.stun @a[r=25] ~~~ 4 1 1",
						"fill ^^^^^1^ mcpe:fire_light replace air",
						"damage @a[r=3] 4",
						"camera @a[r=5, tag=can_flash] fade time 0.1 2.5 3.5 color 255 255 255",
						"camera @a[r=10, tag=can_flash] fade time 0.1 1.8 2 color 255 255 255",
						"camera @a[r=15, tag=can_flash] fade time 0.1 0.5 1.3 color 255 255 255"
					]
				},
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			}
		}
	}
}