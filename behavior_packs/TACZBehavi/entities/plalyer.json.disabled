      "krep:attachmentmode": {
        "sequence": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_mark_variant",
                  "subject": "self",
                  "value": 2,
                  "operator": "!="
                }
              ]
            },
            "add": {
              "component_groups": [
                "krep:attachmentmode"
              ]
            },
            "queue_command": {
              "command": [
                "tag @s add attachmentmode",
                "tag @s remove stockmode",
                "tag @s remove scopemode",
                "tag @s remove miscmode",
                "tag @s remove gripmode"
              ]
            }
          }
        ]
      },
