      "krep:m249_fire": {
        "sequence": [
          {
            "filters": {
              "test": "is_sneaking",
              "value": true,
              "subject": "self"
            },
            "add": {
              "component_groups": [
                "krep:m249_fires"
              ]
            },
            "queue_command": {
              "command": [
                "playanimation @s[r=0.5] animation.m249.shoot.sight shoot",
                "camerashake add @s[r=0.5] 0.047 0.17 rotational"
              ]
            }
          },
          {
            "filters": {
              "test": "is_sneaking",
              "value": false,
              "subject": "self"
            },
            "add": {
              "component_groups": [
                "krep:m249_firest"
              ]
            },
            "queue_command": {
              "command": [
                "playanimation @s[r=0.5] animation.m249.shoot.nsight shoot",
                "camerashake add @s[r=0.5] 0.06 0.2 rotational"
              ]
            }
          }
        ]
      },
