{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m1911": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m1911' && q.is_using_item) || query.get_equipped_item_name=='m1911_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m1911 7",
            "@s[hasitem={item=krep:m1911, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m1911.30": "query.get_equipped_item_name=='m1911' && query.is_using_item && query.scoreboard('m1911') >= 1 && q.mark_variant != 2"
            },
            {
              "m1911.31": "query.get_equipped_item_name=='m1911' && query.is_using_item && query.scoreboard('m1911') == 0"
            }
          ],
          "on_entry": [
            "/function m1911"
          ]
        },
        "m1911.31": {
          "animations": [
            "m1911shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "/replaceitem entity @s[scores={m1911=0}] slot.weapon.mainhand 1 krep:m1911_emp 1 0"
          ]
        },
        "m1911.30": {
          "animations": [
            "m1911shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished && !q.is_using_item"
            }
          ],
          "on_entry": [
            "@s krep:m1911_fire",
            "/scoreboard players remove @s[scores={m1911=1..8}] m1911 1",
            "/scoreboard players set @s[scores={m1911=9..}] m1911 8",
            "/playsound m1911.shoot @a[r=30]",
            "/replaceitem entity @s[scores={m1911=0}] slot.weapon.mainhand 1 krep:m1911_emp 1 0",
            "/title @s[scores={m1911=0}] actionbar No Ammunition"
          ]
        }
      }
    }
  }
}