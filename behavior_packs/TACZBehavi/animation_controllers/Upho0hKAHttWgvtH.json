{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.qbz191": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='qbz191' && q.is_using_item) || query.get_equipped_item_name=='qbz191_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s qbz191 30",
            "@s[hasitem={item=krep:qbz191, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "qbz191.30": "query.get_equipped_item_name=='qbz191' && query.is_using_item && query.scoreboard('qbz191') >= 1 && q.mark_variant != 2"
            },
            {
              "qbz191.31": "query.get_equipped_item_name=='qbz191' && query.is_using_item && query.scoreboard('qbz191') == 0"
            }
          ],
          "on_entry": [
            "/function qbz191"
          ]
        },
        "qbz191.31": {
          "animations": [
            "qbz191shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "/replaceitem entity @s[scores={qbz191=0}] slot.weapon.mainhand 1 krep:qbz191_emp 1 0"
          ]
        },
        "qbz191.30": {
          "animations": [
            "qbz191shoot"
          ],
          "transitions": [
            {
              "delay.30": "query.get_equipped_item_name=='qbz191' && query.is_using_item && query.scoreboard('qbz191') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {
              "setup": "query.scoreboard('qbz191') == 0"
            }
          ],
          "on_entry": [
            "@s krep:qbz191_fire",
            "/function qbz191",
            "/playsound qbz191.shoot @a[r=30]",
            "/scoreboard players set @s[scores={qbz191=32..}] qbz191 31",
            "/scoreboard players remove @s[scores={qbz191=1..31}] qbz191 1",
            "/replaceitem entity @s[scores={qbz191=0}] slot.weapon.mainhand 1 krep:qbz191_emp 1 0",
            "/title @s[scores={qbz191=0}] actionbar No Ammunition"
          ]
        },
        "delay.30": {
          "animations": [
            "qbz191shoot"
          ],
          "transitions": [
            {
              "qbz191.29": "query.get_equipped_item_name=='qbz191' && query.is_using_item && query.scoreboard('qbz191') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {
              "setup": "query.scoreboard('qbz191') == 0"
            }
          ]
        },
        "qbz191.29": {
          "transitions": [
            {
              "qbz191.30": "query.get_equipped_item_name=='qbz191' && query.is_using_item && query.scoreboard('qbz191') >= 1 && q.mark_variant != 2"
            },
            {
              "setup": "query.scoreboard('qbz191') == 0"
            }
          ],
          "on_entry": [
            "@s krep:qbz191_fire",
            "/function qbz191",
            "/playsound qbz191.shoot @a[r=30]",
            "/scoreboard players set @s[scores={qbz191=32..}] qbz191 31",
            "/scoreboard players remove @s[scores={qbz191=1..31}] qbz191 1",
            "/replaceitem entity @s[scores={qbz191=0}] slot.weapon.mainhand 1 krep:qbz191_emp 1 0",
            "/title @s[scores={qbz191=0}] actionbar No Ammunition"
          ]
        }
      }
    }
  }
}