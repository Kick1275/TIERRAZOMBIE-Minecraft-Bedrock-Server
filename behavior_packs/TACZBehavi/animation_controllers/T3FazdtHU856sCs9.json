{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scarl": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='scarl' && q.is_using_item) || query.get_equipped_item_name=='scarl_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s scarl 30",
            "@s[hasitem={item=krep:scarl, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "scarl.30": "query.get_equipped_item_name=='scarl' && query.is_using_item && query.scoreboard('scarl') >= 1 && q.mark_variant != 2"
            },
            {
              "scarl.31": "query.get_equipped_item_name=='scarl' && query.is_using_item && query.scoreboard('scarl') == 0"
            }
          ],
          "on_entry": [
            "/function scarl"
          ]
        },
        "scarl.31": {
          "animations": [
            "scarlshoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "/replaceitem entity @s[scores={scarl=0}] slot.weapon.mainhand 1 krep:scarl_emp 1 0"
          ]
        },
        "scarl.30": {
          "animations": [
            "scarlshoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s krep:scarl_fire",
            "/scoreboard players set @s[scores={scarl=32..}] scarl 31",
            "/scoreboard players remove @s[scores={scarl=1..31}] scarl 1",
            "/playsound scarl.shoot @a[r=30]",
            "/replaceitem entity @s[scores={scarl=0}] slot.weapon.mainhand 1 krep:scarl_emp 1 0",
            "/title @s[scores={scarl=0}] actionbar No Ammunition"
          ]
        }
      }
    }
  }
}