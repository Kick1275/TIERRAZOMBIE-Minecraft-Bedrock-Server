{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m249": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m249' && q.is_using_item) || query.get_equipped_item_name=='m249_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m249 100",
            "@s[hasitem={item=krep:m249, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m249.30": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') >= 1 && q.mark_variant != 2"
            },
            {
              "m249.31": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') == 0"
            }
          ],
          "on_entry": [
            "/function m249"
          ]
        },
        "m249.31": {
          "animations": [
            "m249shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "/replaceitem entity @s[scores={m249=0}] slot.weapon.mainhand 1 krep:m249_emp 1 0"
          ]
        },
        "m249.30": {
          "animations": [
            "m249shoot"
          ],
          "transitions": [
            {
              "delay.30": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {
              "setup": "query.scoreboard('m249') == 0"
            }
          ],
          "on_entry": [
            "@s krep:m249_fire",
            "/function m249",
            "/playsound m249.shoot @a[r=30]",
            "/scoreboard players set @s[scores={m249=101..}] m249 100",
            "/scoreboard players remove @s[scores={m249=1..}] m249 1",
            "/replaceitem entity @s[scores={m249=0}] slot.weapon.mainhand 1 krep:m249_emp 1 0",
            "/title @s[scores={m249=0}] actionbar No Ammunition"
          ]
        },
        "delay.30": {
          "animations": [
            "m249shoot"
          ],
          "transitions": [
            {
              "m249.29": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') >= 1 && q.mark_variant != 2 && q.all_animations_finished"
            },
            {
              "setup": "query.scoreboard('m249') == 0"
            }
          ]
        },
        "m249.29": {
          "transitions": [
            {
              "m249.30": "query.get_equipped_item_name=='m249' && query.is_using_item && query.scoreboard('m249') >= 1 && q.mark_variant != 2"
            },
            {
              "setup": "query.scoreboard('m249') == 0"
            }
          ],
          "on_entry": [
            "@s krep:m249_fire",
            "/function m249",
            "/playsound m249.shoot @a[r=30]",
            "/scoreboard players set @s[scores={m249=101..}] m249 100",
            "/scoreboard players remove @s[scores={m249=1..}] m249 1",
            "/replaceitem entity @s[scores={m249=0}] slot.weapon.mainhand 1 krep:m249_emp 1 0",
            "/title @s[scores={m249=0}] actionbar No Ammunition"
          ]
        }
      }
    }
  }
}