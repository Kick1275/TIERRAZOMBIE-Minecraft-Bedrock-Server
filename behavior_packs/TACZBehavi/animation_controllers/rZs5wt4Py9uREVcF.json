{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m870": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m870' && q.is_using_item) || query.get_equipped_item_name=='m870_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s m870 5",
            "@s[hasitem={item=krep:m870, location=slot.weapon.mainhand}] krep:noreload",
            "@s m870:normal"
          ]
        },
        "jawir": {
          "animations": [
            "m870delay"
          ],
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='m870' || query.get_equipped_item_name=='m870_emp') && q.all_animations_finished && q.is_using_item"
            }
          ],
          "on_entry": [
            "@s m870:normal"
          ]
        },
        "setup": {
          "transitions": [
            {
              "m870.30": "query.get_equipped_item_name=='m870' && query.is_using_item && query.scoreboard('m870') >= 1 && (q.mark_variant != 2 && q.mark_variant!=1)"
            },
            {
              "m870.31": "query.get_equipped_item_name=='m870' && query.is_using_item && query.scoreboard('m870') == 0"
            }
          ],
          "on_entry": [
            "/function m870"
          ]
        },
        "m870.31": {
          "animations": [
            "m870shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "/replaceitem entity @s[scores={m870=0}] slot.weapon.mainhand 1 krep:m870_emp 1 0"
          ]
        },
        "m870.30": {
          "animations": [
            "m870shoot"
          ],
          "transitions": [
            {
              "bolt": "query.all_animations_finished && query.get_equipped_item_name=='m870' && q.mark_variant!= 2"
            },
            {
              "setup": "query.get_equipped_item_name!='m870'"
            },
            {
              "setup": "query.get_equipped_item_name=='m870' && q.mark_variant == 2"
            }
          ],
          "on_entry": [
            "@s krep:m870_fire",
            "/scoreboard players remove @s[scores={m870=1..6}] m870 1",
            "/scoreboard players set @s[scores={m870=7..}] m870 6",
            "/playsound m870.shoot @a[r=30]",
            "/replaceitem entity @s[scores={m870=0}] slot.weapon.mainhand 1 krep:m870_emp 1 0",
            "/title @s[scores={m870=0}] actionbar No Ammunition"
          ]
        },
        "bolt": {
          "animations": [
            "m870bolt"
          ],
          "transitions": [
            {
              "jawir": "query.all_animations_finished"
            },
            {
              "jawir": "query.get_equipped_item_name!='m870'"
            }
          ],
          "on_entry": [
            "@s m870:bolt",
            "/function m870"
          ]
        }
      }
    }
  }
}