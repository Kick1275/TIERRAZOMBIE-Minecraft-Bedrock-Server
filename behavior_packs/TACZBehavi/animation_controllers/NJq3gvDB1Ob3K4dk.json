{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.m249.reload": {
      "initial_state": "setup",
      "states": {
        "setup": {
          "on_entry": [
            "@s krep:noreload"
          ],
          "transitions": [
            {
              "trigger.reload": "query.get_equipped_item_name=='m249_emp' && variable.attack_time == 0.0 && q.is_using_item"
            },
            {
              "trigger.tac": "(query.get_equipped_item_name=='m249' && variable.attack_time > 0.0f && query.scoreboard('m249') <= 99) || (query.get_equipped_item_name=='m249' && q.mark_variant == 2)"
            }
          ]
        },
        "trigger.tac": {
          "on_entry": [
            "/function m249quantity",
            "@s krep:noreload",
            "@s evolys:reset"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m249' && q.property('krep:ammoreload') == 0"
            },
            {
              "reload.tac": "query.get_equipped_item_name=='m249' && q.property('krep:ammoreload') >= 1"
            },
            {
              "setup": "query.get_equipped_item_name!='m249'"
            }
          ]
        },
        "trigger.reload": {
          "on_entry": [
            "/function m249quantity",
            "@s krep:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m249_emp' && q.property('krep:ammoreload') == 0"
            },
            {
              "reload": "query.get_equipped_item_name=='m249_emp' && q.property('krep:ammoreload') >= 1"
            },
            {
              "setup": "query.get_equipped_item_name!='m249'"
            }
          ]
        },
        "reload": {
          "animations": [
            {
              "m249reload": "query.get_equipped_item_name('main_hand')=='m249_emp' || query.get_equipped_item_name('main_hand')=='m249'"
            }
          ],
          "on_entry": [
            "@s krep:reload"
          ],
          "on_exit": [
            "@s krep:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name!='m249_emp'"
            },
            {
              "reloadfinish": "query.all_animations_finished"
            }
          ]
        },
        "reload.tac": {
          "animations": [
            {
              "m249reloadtac": "query.get_equipped_item_name('main_hand')=='m249_emp' || query.get_equipped_item_name('main_hand')=='m249'"
            }
          ],
          "on_entry": [
            "@s krep:reloadtac"
          ],
          "on_exit": [
            "@s krep:noreload"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name!='m249'"
            },
            {
              "reloadfinish": "query.all_animations_finished"
            }
          ]
        },
        "reloadfinish": {
          "on_entry": [
            "/function m249",
            "@s evolys:reset"
          ],
          "transitions": [
            {
              "setup": "query.get_equipped_item_name=='m249' || query.get_equipped_item_name=='m249_emp'"
            }
          ]
        }
      }
    }
  }
}