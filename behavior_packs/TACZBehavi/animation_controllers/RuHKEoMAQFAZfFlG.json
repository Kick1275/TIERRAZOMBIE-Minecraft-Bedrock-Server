{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.akm": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='akm' && q.is_using_item) || query.get_equipped_item_name=='akm_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s akm 30",
            "@s[hasitem={item=krep:akm, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "akm.30": "query.get_equipped_item_name=='akm' && query.is_using_item && query.scoreboard('akm') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle')<=3"
            },
            {
              "suppress.30": "query.get_equipped_item_name=='akm' && query.is_using_item && query.scoreboard('akm') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle')>=4"
            },
            {
              "akm.31": "query.get_equipped_item_name=='akm' && query.is_using_item && query.scoreboard('akm') == 0"
            }
          ],
          "on_entry": [
            "/function akm"
          ]
        },
        "akm.31": {
          "animations": [
            "akmshoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "/replaceitem entity @s[scores={akm=0}] slot.weapon.mainhand 1 krep:akm_emp 1 0"
          ]
        },
        "akm.30": {
          "animations": [
            "akmshoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s krep:akm_fire",
            "/scoreboard players set @s[scores={akm=32..}] akm 31",
            "/scoreboard players remove @s[scores={akm=1..31}] akm 1",
            "/playsound akm.shoot @a[r=30]",
            "/replaceitem entity @s[scores={akm=0}] slot.weapon.mainhand 1 krep:akm_emp 1 0",
            "/title @s[scores={akm=0}] actionbar No Ammunition"
          ]
        },
        "suppress.30": {
          "animations": [
            "akmshoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s krep:akm_fire",
            "/scoreboard players set @s[scores={akm=32..}] akm 31",
            "/scoreboard players remove @s[scores={akm=1..31}] akm 1",
            "/playsound akm.suppress @a[r=20]",
            "/replaceitem entity @s[scores={akm=0}] slot.weapon.mainhand 1 krep:akm_emp 1 0",
            "/title @s[scores={akm=0}] actionbar No Ammunition"
          ]
        }
      }
    },
