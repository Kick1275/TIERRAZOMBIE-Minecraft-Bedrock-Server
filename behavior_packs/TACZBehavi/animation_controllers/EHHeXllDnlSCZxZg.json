            "/title @s[scores={hk416=0}] actionbar No Ammunition",
            "/function hk416"
          ]
        },
        "hk416.30s": {
          "animations": [
            "hk416shoot"
          ],
          "transitions": [
            {
              "setup": "query.scoreboard('hk416') == 0"
            },
            {
              "setup": "q.property('krep:muzzle') < 4"
            },
            {
              "delay.30s": "query.get_equipped_item_name=='hk416' && query.is_using_item && query.scoreboard('hk416') >= 1 && q.mark_variant != 2 && query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s krep:hk416_fire",
            "/scoreboard players add @s[scores={hk416sound=0}] hk416soundsound 1",
            "@s krep:hk416_firegrip",
            "/playsound hk416.suppress @a[r=15]",
            "/scoreboard players set @s[scores={hk416=32..}] hk416 31",
            "/scoreboard players remove @s[scores={hk416=1..31}] hk416 1",
            "/replaceitem entity @s[scores={hk416=0}] slot.weapon.mainhand 1 krep:hk416_emp 1 0",
            "/title @s[scores={hk416=0}] actionbar No Ammunition",
            "/function hk416"
          ]
        },
        "delay.30s": {
          "animations": [
            "hk416shoot"
          ],
          "transitions": [
            {
              "setup": "query.scoreboard('hk416') == 0"
            },
            {
              "hk416.29s": "query.get_equipped_item_name=='hk416' && query.is_using_item && query.scoreboard('hk416') >= 1 && q.mark_variant != 2 && query.all_animations_finished"
            },
            {
              "setup": "query.get_equipped_item_name=='hk416' && !query.is_using_item"
            }
