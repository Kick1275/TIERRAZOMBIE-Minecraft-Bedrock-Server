{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.g17": {
      "initial_state": "setup1",
      "states": {
        "setup1": {
          "transitions": [
            {
              "setup": "(query.get_equipped_item_name=='g17' && q.is_using_item) || query.get_equipped_item_name=='g17_emp'"
            }
          ],
          "on_entry": [
            "/scoreboard players set @s g17 17",
            "@s[hasitem={item=krep:g17, location=slot.weapon.mainhand}] krep:noreload"
          ]
        },
        "setup": {
          "transitions": [
            {
              "g17.30": "query.get_equipped_item_name=='g17' && query.is_using_item && query.scoreboard('g17') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle')==0"
            },
            {
              "g17s.30": "query.get_equipped_item_name=='g17' && query.is_using_item && query.scoreboard('g17') >= 1 && q.mark_variant != 2 && q.property('krep:muzzle')>=1"
            },
            {
              "g17.31": "query.get_equipped_item_name=='g17' && query.is_using_item && query.scoreboard('g17') == 0"
            }
          ],
          "on_entry": [
            "/function g17"
          ]
        },
        "g17.31": {
          "animations": [
            "g17shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "/replaceitem entity @s[scores={g17=0}] slot.weapon.mainhand 1 krep:g17_emp 1 0"
          ]
        },
        "g17.30": {
          "animations": [
            "g17shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s krep:g17_fire",
            "/scoreboard players remove @s[scores={g17=1..18}] g17 1",
            "/scoreboard players set @s[scores={g17=19..}] g17 18",
            "/playsound g17.shoot @a[r=30]",
            "/replaceitem entity @s[scores={g17=0}] slot.weapon.mainhand 1 krep:g17_emp 1 0",
            "/title @s[scores={g17=0}] actionbar No Ammunition"
          ]
        },
        "g17s.30": {
          "animations": [
            "g17shoot"
          ],
          "transitions": [
            {
              "setup": "query.all_animations_finished"
            }
          ],
          "on_entry": [
            "@s krep:g17_fire",
            "/scoreboard players remove @s[scores={g17=1..18}] g17 1",
            "/scoreboard players set @s[scores={g17=19..}] g17 18",
            "/playsound g17.suppress @a[r=15]",
            "/replaceitem entity @s[scores={g17=0}] slot.weapon.mainhand 1 krep:g17_emp 1 0",
            "/title @s[scores={g17=0}] actionbar No Ammunition"
          ]
        }
      }
    }
  }
}