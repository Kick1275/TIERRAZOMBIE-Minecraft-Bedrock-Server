{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:nasams_missile",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"components": {
			"minecraft:collision_box": {
				"width": 1,
				"height": 1
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": true
			},
			"minecraft:conditional_bandwidth_optimization": {
				"default_values": {
					"max_optimized_distance": 80,
					"max_dropped_ticks": 10,
					"use_motion_prediction_hints": true
				}
			},
			"minecraft:tick_world": {
				"never_despawn": true
			},
			"minecraft:timer": {
				"looping": false,
				"time": 2,
				"time_down_event": {
					"event": "af:explodable",
					"target": "self"
				}
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "entity_explosion",
						"on_damage": {
							"event": "minecraft:explode",
							"target": "self"
						}
					},
					{
						"cause": "suffocation",
						"on_damage": {
							"event": "minecraft:explode",
							"target": "self"
						}
					},
					{
						"cause": "projectile",
						"on_damage": {
							"event": "minecraft:explode",
							"target": "self"
						}
					}
				]
			},
			"minecraft:fire_immune": {},
			"minecraft:breathable": {
				"breathes_air": true,
				"total_supply": 0,
				"suffocateTime": 0
			},
			"minecraft:environment_sensor": {
				"triggers": {
					"event": "af:sound",
					"filters": {
						"test": "on_ground",
						"subject": "self",
						"value": false
					},
					"target": "self"
				}
			},
			"minecraft:scale": {
				"value": 1.7
			},
			"minecraft:type_family": {
				"family": [
					"libernia",
					"c_ram",
					"libernia_missile"
				]
			},
			"minecraft:behavior.nearest_attackable_target": {
				"priority": 0,
				"within_radius": 32,
				"entity_types": {
					"filters": {
						"any_of": [
							{
								"test": "is_family",
								"subject": "other",
								"value": "libernia",
								"operator": "!="
							},
							{
								"test": "is_family",
								"subject": "other",
								"value": "player",
								"operator": "!="
							}
						]
					},
					"max_dist": 64,
					"must_see": false
				},
				"target_search_height": 64,
				"reselect_targets": true,
				"scan_interval": 20
			}
		},
		"events": {
			"minecraft:explode": {
				"add": {
					"component_groups": [
						"minecraft:exploding"
					]
				},
				"queue_command": {
					"command": [
						"particle af:explosion_disc ~ ~1 ~"
					]
				}
			},
			"minecraft:entity_spawned": {},
			"af:despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			},
			"af:explodable": {
				"add": {
					"component_groups": [
						"explosion_sensor"
					]
				}
			},
			"af:sound": {
				"queue_command": {
					"command": [
						"playsound mob.blaze.shoot @a ~ ~ ~ 50 0.5"
					]
				}
			},
			"af:roar": {
				"queue_command": {
					"command": [
						"event entity @e[type=af:sam_turret,c=1] af:start_roar",
						"tp @s ^ ^2 ^2"
					]
				}
			}
		},
		"component_groups": {
			"minecraft:exploding": {
				"minecraft:explode": {
					"fuse_length": 0,
					"fuse_lit": true,
					"power": 3,
					"causes_fire": true,
					"breaks_blocks": true,
					"destroy_affected_by_griefing": true
				}
			},
			"despawn": {
				"minecraft:instant_despawn": {}
			},
			"explosion_sensor": {
				"minecraft:target_nearby_sensor": {
					"inside_range": 1,
					"on_inside_range": {
						"event": "minecraft:explode",
						"target": "self"
					},
					"outside_range": 2
				},
				"minecraft:timer": {
					"looping": false,
					"time": 5,
					"time_down_event": {
						"event": "minecraft:explode",
						"target": "self"
					}
				}
			}
		}
	}
}