{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:guided_missile",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"components": {
			"minecraft:collision_box": {
				"width": 2,
				"height": 2
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": true
			},
			"minecraft:conditional_bandwidth_optimization": {
				"default_values": {
					"max_optimized_distance": 80,
					"max_dropped_ticks": 10,
					"use_motion_prediction_hints": true
				}
			},
			"minecraft:timer": {
				"looping": true,
				"time": 10,
				"time_down_event": {
					"event": "af:explode",
					"target": "self"
				}
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "suffocation",
						"on_damage": {
							"event": "af:explode",
							"target": "self"
						}
					},
					{
						"cause": "projectile",
						"on_damage": {
							"event": "af:explode",
							"target": "self"
						}
					},
					{
						"cause": "drowning",
						"on_damage": {
							"event": "af:explode",
							"target": "self"
						}
					},
					{
						"cause": "entity_explosion",
						"deals_damage": false
					}
				]
			},
			"minecraft:fire_immune": {},
			"minecraft:breathable": {
				"breathes_air": true,
				"total_supply": 0,
				"suffocateTime": 0
			},
			"minecraft:tick_world": {
				"never_despawn": true
			},
			"minecraft:on_death": {
				"event": "af:explode",
				"target": "self"
			},
			"minecraft:type_family": {
				"family": [
					"inanimate"
				]
			}
		},
		"events": {
			"af:explode": {
				"add": {
					"component_groups": [
						"minecraft:exploding"
					]
				},
				"queue_command": {
					"command": [
						"tag @s add gm_exploded",
						"execute as @s[tag=libernia] run execute at @e[tag=GM_fired,family=libernia] run title @p[r=1] actionbar Missile Detonated",
						"execute as @s[tag=telslakia] run execute at @e[tag=GM_fired,family=telslakia] run title @p[r=1] actionbar Missile Detonated",
						"execute as @s[tag=libernia] run tag @e[tag=GM_fired,family=libernia] remove GM_fired",
						"execute as @s[tag=telslakia] run tag @e[tag=GM_fired,family=telslakia] remove GM_fired",
						"particle af:explosion_main ~ ~1 ~",
						"damage @e[r=8,family=!inanimate] 250 entity_explosion entity @s",
						"damage @e[r=8,type=ender_dragon] 60 entity_attack entity @p"
					]
				}
			},
			"minecraft:entity_spawned": {
				"queue_command": {
					"command": [
						"tp @s ^ ^2 ^5",
						"playsound missile.fire @a ~ ~ ~ 100 1"
					]
				}
			},
			"af:m551_libernia": {
				"queue_command": {
					"command": [
						"tag @s add m551",
						"tag @s add libernia",
						"playsound missile.fire @a ~ ~ ~",
						"tp @s ^ ^2 ^2"
					]
				}
			},
			"af:m551_telslakia": {
				"queue_command": {
					"command": [
						"tag @s add bmpt72",
						"tag @s add telslakia",
						"playsound missile.fire @a ~ ~ ~ 100 1",
						"tp @s ^ ^2 ^2"
					]
				}
			},
			"af:bmpt72_libernia": {
				"sequence": [
					{
						"queue_command": {
							"command": [
								"tag @s add bmpt72",
								"tag @s add libernia",
								"playsound missile.fire @a ~ ~ ~ 100 1"
							]
						}
					},
					{
						"randomize": [
							{
								"queue_command": {
									"command": [
										"tp @s ^-1.5 ^2 ^2"
									]
								},
								"weight": 50
							},
							{
								"queue_command": {
									"command": [
										"tp @s ^1.5 ^2 ^2"
									]
								},
								"weight": 50
							}
						]
					}
				]
			},
			"af:bmpt72_telslakia": {
				"sequence": [
					{
						"queue_command": {
							"command": [
								"tag @s add bmpt72",
								"tag @s add telslakia",
								"playsound missile.fire @a ~ ~ ~ 100 1"
							]
						}
					},
					{
						"randomize": [
							{
								"queue_command": {
									"command": [
										"tp @s ^-1.5 ^2 ^2"
									]
								},
								"weight": 50
							},
							{
								"queue_command": {
									"command": [
										"tp @s ^1.5 ^2 ^2"
									]
								},
								"weight": 50
							}
						]
					}
				]
			},
			"af:m2a2_libernia": {
				"queue_command": {
					"command": [
						"tag @s add m2a2",
						"tag @s add libernia",
						"playsound missile.fire @a ~ ~ ~ 100 1",
						"tp @s ^1.5 ^3.5 ^2"
					]
				}
			},
			"af:m2a2_telslakia": {
				"queue_command": {
					"command": [
						"tag @s add m2a2",
						"tag @s add telslakia",
						"playsound missile.fire @a ~ ~ ~ 100 1",
						"tp @s ^1.5 ^3.5 ^2"
					]
				}
			}
		},
		"component_groups": {
			"minecraft:exploding": {
				"minecraft:explode": {
					"fuse_length": 0.1,
					"fuse_lit": true,
					"power": 3,
					"causes_fire": true,
					"breaks_blocks": true,
					"destroy_affected_by_griefing": true
				}
			}
		}
	}
}