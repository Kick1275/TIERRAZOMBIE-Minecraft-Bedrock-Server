{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "af:antitank_mine",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"primed": {
				"minecraft:is_ignited": {},
				"minecraft:target_nearby_sensor": {
					"inside_range": 0.5,
					"outside_range": 1,
					"on_outside_range": {
						"event": "af:explode",
						"target": "self"
					},
					"must_see": false
				}
			},
			"explode": {
				"minecraft:explode": {
					"fuse_length": 0.1,
					"power": 5,
					"fuse_lit": true,
					"causes_fire": true,
					"breaks_blocks": true,
					"fire_affected_by_griefing": true,
					"destroy_affected_by_griefing": true
				}
			},
			"despawn": {
				"minecraft:instant_despawn": {}
			},
			"idle": {
				"minecraft:target_nearby_sensor": {
					"inside_range": 0.5,
					"outside_range": 1,
					"on_inside_range": {
						"event": "af:primed",
						"target": "self"
					},
					"must_see": false
				}
			}
		},
		"components": {
			"minecraft:on_hurt_by_player": {
				"event": "af:explode",
				"target": "self"
			},
			"minecraft:health": {
				"value": 1000
			},
			"minecraft:collision_box": {
				"width": 0.1,
				"height": 1
			},
			"minecraft:physics": {},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"on_damage": {
							"event": "af:explode",
							"target": "self"
						},
						"cause": "entity_attack"
					},
					{
						"cause": "entity_explosion",
						"deals_damage": false
					},
					{
						"cause": "fall",
						"deals_damage": false
					}
				]
			},
			"minecraft:type_family": {
				"family": [
					"inanimate"
				]
			},
			"minecraft:knockback_resistance": {
				"value": 0.9,
				"max": 1
			},
			"minecraft:interact": {
				"interactions": [
					{
						"add_items": {
							"table": "loot_tables/antitank_mine.json"
						},
						"on_interact": {
							"event": "af:despawn",
							"filters": [
								{
									"any_of": [
										{
											"test": "has_equipment",
											"domain": "hand",
											"subject": "other",
											"value": "minecraft:netherite_shovel"
										},
										{
											"test": "has_equipment",
											"domain": "hand",
											"subject": "other",
											"value": "minecraft:diamond_shovel"
										},
										{
											"test": "has_equipment",
											"domain": "hand",
											"subject": "other",
											"value": "minecraft:iron_shovel"
										},
										{
											"test": "has_equipment",
											"domain": "hand",
											"subject": "other",
											"value": "minecraft:golden_shovel"
										},
										{
											"test": "has_equipment",
											"domain": "hand",
											"subject": "other",
											"value": "minecraft:wooden_shovel"
										}
									]
								}
							]
						},
						"play_sounds": "eat",
						"interact_text": "action.interact.use"
					},
					{
						"on_interact": {
							"event": "af:manual",
							"target": "self",
							"filters": [
								{
									"test": "has_equipment",
									"subject": "other",
									"domain": "hand",
									"value": "af:manual"
								}
							]
						},
						"interact_text": "action.interact.use",
						"play_sounds": "purr"
					}
				]
			},
			"minecraft:loot": {
				"table": "loot_tables/antitank_mine.json"
			},
			"minecraft:behavior.nearest_attackable_target": {
				"priority": 0,
				"within_radius": 8,
				"reselect_targets": true,
				"entity_types": {
					"filters": {
						"test": "is_family",
						"subject": "other",
						"value": "vehicle"
					},
					"must_see": false,
					"max_dist": 16
				}
			},
			"minecraft:custom_hit_test": {
				"hitboxes": [
					{
						"width": 1,
						"height": 1,
						"pivot": [
							0,
							0,
							0
						]
					}
				]
			},
			"minecraft:fire_immune": true
		},
		"events": {
			"af:explode": {
				"add": {
					"component_groups": [
						"explode"
					]
				},
				"queue_command": {
					"command": [
						"damage @e[r=5,family=!inaminate] 100 entity_explosion entity @s",
						"particle af:explosion_dust ~ ~ ~"
					]
				}
			},
			"af:despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			},
			"af:manual": {
				"queue_command": {
					"command": [
						"title @a[r=5] actionbar Can be removed via interaction with a shovel."
					]
				}
			},
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"idle"
					]
				}
			},
			"af:primed": {
				"add": {
					"component_groups": [
						"primed"
					]
				},
				"remove": {
					"component_groups": [
						"idle"
					]
				},
				"queue_command": {
					"command": [
						"playsound random.fuse @a ~ ~ ~"
					]
				}
			}
		}
	}
}